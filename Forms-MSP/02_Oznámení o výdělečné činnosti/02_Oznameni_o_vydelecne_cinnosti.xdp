                  <value>
                     <exData contentType="text/html">
                        <body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p style="letter-spacing:0in">* Povinný údaj</p><p style="letter-spacing:0in"><span style="xfa-spacerun:yes"> </span></p><p style="text-indent:-14.173pt;vertical-align:3pt;font-size:6pt;letter-spacing:0in">1)<span style="vertical-align:baseline;font-size:8pt"> Dle § 85a odst. 1 zákona o soudech a soudcích se obdobím rozumí předchozí kalendářní rok. Došlo-li k zahájení výkonu funkce soudce v průběhu předchozího kalendářního roku, bude počátkem období den stanovený jako den nástupu do funkce.<span style="xfa-spacerun:yes"> </span></span></p><p style="vertical-align:3pt;font-size:6pt;letter-spacing:0in">2)<span style="xfa-spacerun:yes"> </span><span style="vertical-align:baseline;font-size:8pt">Dle § 85a odst. 1 zákona o soudech a soudcích nespadá pod toto oznámení správa vlastního majetku.</span></p><p style="letter-spacing:0in"><span style="xfa-spacerun:yes"> </span></p></body>
                     </exData>
                  </value>
                  <font size="8pt" typeface="Myriad Pro" baselineShift="0pt">
                     <fill>
                        <color value="91,91,93"/>
                     </fill>
                  </font>
