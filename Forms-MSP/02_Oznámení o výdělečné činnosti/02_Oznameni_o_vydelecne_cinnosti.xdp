                        <bind match="dataRef" ref="$.specifikace"/>
                     </field>
                     <field name="identifikace" w="73.948mm" h="11.5mm">
                        <ui>
                           <choiceList commitOn="select">
                              <border>
                                 <corner thickness="0.1mm">
                                    <color value="180,180,180"/>
                                 </corner>
                                 <edge thickness="0.1mm">
                                    <color value="180,180,180"/>
                                 </edge>
                              </border>
                              <margin/>
                           </choiceList>
                        </ui>
                        <font typeface="Myriad Pro">
                           <fill>
                              <color value="51,51,51"/>
                           </fill>
                        </font>
                        <margin bottomInset="0.5mm" leftInset="2mm" rightInset="2mm" topInset="2mm"/>
                        <para marginLeft="2.835pt" marginRight="2.835pt" spaceAbove="0pt" vAlign="middle"/>
                        <caption placement="top" reserve="2.9264mm">
                           <font typeface="Myriad Pro" size="8pt">
                              <fill>
                                 <color value="91,91,93"/>
                              </fill>
                           </font>
                           <para marginLeft="2.835pt" marginRight="2.835pt"/>
                           <value>
                              <text>Identifikace subjektu, pro který byla činnost vykonána*:</text>
                           </value>
                        </caption>
                        <assist>
                           <speak priority="toolTip"/>
                           <toolTip>Uveďte typ subjektu, pro který byla činnost vykonána.</toolTip>
                        </assist>
                        <bind match="dataRef" ref="$.identifikace">
                           <picture>null{}</picture>
                        </bind>
                        <format>
                           <picture>null{}|date{D.M.YYYY}</picture>
                        </format>
                        <validate formatTest="error" scriptTest="warning">
                           <message>
                              <text name="scriptTest"/>
                              <text name="formatTest"/>
                           </message>
                        </validate>
                        <items>
                           <text>Nepodnikající fyzická osoba</text>
                           <text>Podnikající fyzická osoba</text>
                           <text>Právnická osoba</text>
                        </items>
                        <items save="1" presence="hidden">
                           <text>0</text>
                           <text>1</text>
                           <text>2</text>
                        </items>
                        <event activity="exit" name="event__exit">
                           <script contentType="application/x-javascript" runAt="both">
if (this.rawValue == 0) {
	if (_nepodnikajici_FO.count == 0) _nepodnikajici_FO.addInstance(1);
	_podnikajici_FO.setInstances(0);
	_PO.setInstances(0);
	xfa.host.setFocus(nepodnikajici_FO.wrapper.jmeno);
}
if (this.rawValue == 1) {
	_nepodnikajici_FO.setInstances(0);
	if (_podnikajici_FO.count == 0) _podnikajici_FO.addInstance(1);
	_PO.setInstances(0);
	xfa.host.setFocus(podnikajici_FO.wrapper.jmeno);
}
if (this.rawValue == 2) {
	_nepodnikajici_FO.setInstances(0);
	_podnikajici_FO.setInstances(0);
	if (_PO.count == 0) _PO.addInstance(1);
	xfa.host.setFocus(PO.wrapper.jmeno);
}
</script>
                        </event>
                     </field>
