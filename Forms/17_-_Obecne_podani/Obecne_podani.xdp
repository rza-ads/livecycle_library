var pr_os = "";
var t_za_os = "";


var oVeritel_root = xfa.resolveNode("podatel.wrapper.podatel_wrapper[" + (this.parent.index + 1) + "]");
var oVeritel = null;

if (oVeritel_root != null) {

	if (oVeritel_root.zastupce_wrapper.druh_zastupce.rawValue == 0) {
		oVeritel =  oVeritel_root.resolveNode("veritel");
		sharedLib.setOnValueChange(rb_podepisujici_osoba, 1);
		
	}
	else {
		oVeritel = oVeritel_root.resolveNode("zastupce_wrapper.zastupce");
		sharedLib.setOnValueChange(rb_podepisujici_osoba, 2);
	}
	
	if ( oVeritel != null  ) {
		if (oVeritel._fyzicka_osoba.count == 1) {
			t_pred_os = oVeritel.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.titul_pred.rawValue;
			jm_os = oVeritel.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.jmeno.rawValue;
			pr_os = oVeritel.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.prijmeni.rawValue;
			t_za_os = oVeritel.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.titul_za.rawValue;
	
			if(podpis_udaje.podepisujici.osoba.localOverrideLib.get() != "false"){
				sharedLib.setOnValueChange(podpis_udaje.podepisujici.osoba.titul_pred, t_pred_os);
				sharedLib.setOnValueChange(podpis_udaje.podepisujici.osoba.jmeno, jm_os);
				sharedLib.setOnValueChange(podpis_udaje.podepisujici.osoba.prijmeni, pr_os);
				sharedLib.setOnValueChange(podpis_udaje.podepisujici.osoba.titul_za, t_za_os);
			};
		};
	};
	
};	
</script>
                     </calculate>
                     <event activity="initialize" ref="$" name="event__initialize">
                        <script contentType="application/x-javascript">
var podp_cont = "";


var oVeritel_root = xfa.resolveNode("podatel.wrapper.podatel_wrapper[" + (this.parent.index + 1) + "]");
var oVeritel = null;

if (oVeritel_root.zastupce_wrapper.druh_zastupce.rawValue == 0) {
	oVeritel = oVeritel_root.resolveNode("veritel");
}
else {
	oVeritel = oVeritel_root.resolveNode("zastupce_wrapper.zastupce");
}

if (oVeritel != null ) {
	if (oVeritel._fyzicka_osoba.count == 1) {
			 podp_cont = localLib.podpisConcatenate(oVeritel.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba) ;

			if (localLib.podpisConcatenate(podpis_udaje.podepisujici.osoba) != podp_cont ) {
								podpis_udaje.podepisujici.osoba.localOverrideLib.set();
					}
	};
};
</script>
                     </event>
