                  <subform layout="lr-tb" minH="111.999mm" name="zastupce_wrapper" w="190mm" y="3mm">
                     <bind match="none"/>
                     <field h="7mm" name="druh_zastupce" w="95mm">
                        <caption reserve="32.5mm">
                           <font typeface="Myriad Pro" baselineShift="0pt" size="9pt">
                              <fill>
                                 <color value="51,51,51"/>
                              </fill>
                           </font>
                           <para spaceAbove="1pt" vAlign="middle"/>
                           <value>
                              <text>Druh  zástupce:</text>
                           </value>
                        </caption>
                        <font typeface="Myriad Pro">
                           <fill>
                              <color value="51,51,51"/>
                           </fill>
                        </font>
                        <items>
                           <text>není</text>
                           <text>na základě plné moci</text>
                           <text>na základě zákona</text>
                           <text>na základě rozhodnutí</text>
                        </items>
                        <items presence="hidden" save="1">
                           <text>0</text>
                           <text>1</text>
                           <text>2</text>
                           <text>3</text>
                        </items>
                        <margin bottomInset="1mm" leftInset="2mm" rightInset="2mm" topInset="1mm"/>
                        <para marginLeft="2.835pt" marginRight="2.835pt" spaceAbove="1pt" spaceBelow="0pt" vAlign="middle"/>
                        <ui>
                           <choiceList>
                              <border>
                                 <corner thickness="0.1mm">
                                    <color value="180,180,180"/>
                                 </corner>
                                 <edge thickness="0.1mm">
                                    <color value="180,180,180"/>
                                 </edge>
                              </border>
                              <margin/>
                           </choiceList>
                        </ui>
                        <bind ref="$.druh_zastupce" match="dataRef"/>
                        <value>
                           <text>0</text>
                        </value>
                        <event activity="exit" name="event__exit">
                           <script contentType="application/x-javascript">
if (this.rawValue == 0) {
	_zastupce.setInstances(0);
	}
else { 
	_zastupce.setInstances(1);

}
</script>
                        </event>
                     </field>
                     <subform layout="lr-tb" minH="111.999mm" name="zastupce" w="190mm">
                        <occur min="0"/>
                        <bind ref="$.zastupce" match="dataRef"/>
                        <subform layout="lr-tb" name="druh_osoby" w="95mm">
                           <bind match="none"/>
                           <exclGroup layout="lr-tb" name="druh">
                              <margin leftInset="1mm"/>
                              <bind ref="$.fo_po_switch" match="dataRef"/>
                              <field h="7mm" name="fyzicka" w="47mm">
                                 <caption placement="right" reserve="38mm">
                                    <font typeface="Myriad Pro">
                                       <fill>
                                          <color value="51,51,51"/>
                                       </fill>
                                    </font>
                                    <para spaceAbove="1pt" vAlign="middle"/>
                                    <value>
                                       <text>Fyzická osoba</text>
                                    </value>
                                 </caption>
                                 <font typeface="Myriad Pro">
                                    <fill>
                                       <color value="251,85,91"/>
                                    </fill>
                                 </font>
                                 <items>
                                    <text>1</text>
                                 </items>
                                 <margin leftInset="1mm" rightInset="1mm"/>
                                 <para vAlign="middle"/>
                                 <ui>
                                    <checkButton shape="round" size="3.8806mm">
                                       <border>
                                          <corner thickness="0.2mm">
                                             <color value="130,130,130"/>
                                          </corner>
                                          <edge thickness="0.2mm">
                                             <color value="130,130,130"/>
                                          </edge>
                                          <fill/>
                                       </border>
                                       <margin/>
                                    </checkButton>
                                 </ui>
                                 <bind match="none"/>
                              </field>
                              <field h="7mm" name="pravnicka" w="47mm">
                                 <caption placement="right" reserve="38mm">
                                    <font typeface="Myriad Pro">
                                       <fill>
                                          <color value="51,51,51"/>
                                       </fill>
                                    </font>
                                    <para spaceAbove="1pt" vAlign="middle"/>
                                    <value>
                                       <text>Právnická osoba</text>
                                    </value>
                                 </caption>
                                 <font typeface="Myriad Pro">
                                    <fill>
                                       <color value="251,85,91"/>
                                    </fill>
                                 </font>
                                 <items>
                                    <text>2</text>
                                 </items>
                                 <margin leftInset="1mm" rightInset="1mm"/>
                                 <para vAlign="middle"/>
                                 <ui>
                                    <checkButton shape="round" size="3.8806mm">
                                       <border>
                                          <corner thickness="0.2mm">
                                             <color value="130,130,130"/>
                                          </corner>
                                          <edge thickness="0.2mm">
                                             <color value="130,130,130"/>
                                          </edge>
                                          <fill/>
                                       </border>
                                       <margin/>
                                    </checkButton>
                                 </ui>
                                 <bind match="none"/>
                              </field>
                              <event activity="change" name="event__change">
                                 <script contentType="application/x-javascript">
// fyzicka
if (this.rawValue == '1') {
	this.parent.parent._pravnicka_osoba.setInstances(0);
	this.parent.parent._fyzicka_osoba.addInstance(1);
	// TODO: pridat dve instance, kdyz je spolecne oddluzeni
}

// pravnicka
if (this.rawValue == '2') {

	this.parent.parent._fyzicka_osoba.setInstances(0);
	this.parent.parent._pravnicka_osoba.addInstance(1);
}

</script>
                              </event>
                              <?templateDesigner itemValuesSpecified 1?>
                              <?templateDesigner expand 0?></exclGroup>
                           <?templateDesigner expand 1?></subform>
