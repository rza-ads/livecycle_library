                           <event activity="change" name="event__change">
                              <script contentType="application/x-javascript">

if (this.rawValue == null)
	sharedLib.hideIfVisible(zastupce_wrapper.druh_zastupce);
else
	sharedLib.visibleIfHidden(zastupce_wrapper.druh_zastupce);

// fyzicka
if (this.rawValue == '1') {
	this.parent.parent._pravnicka_osoba.setInstances(0);
	this.parent.parent._fyzicka_osoba.addInstance(1);
	// TODO: pridat dve instance, kdyz je spolecne oddluzeni
	
}

// pravnicka
if (this.rawValue == '2') {
	this.parent.parent._fyzicka_osoba.setInstances(0);
	this.parent.parent._pravnicka_osoba.addInstance(1);
}

</script>
                           </event>
                           <event activity="initialize" name="event__initialize">
                              <script contentType="application/x-javascript">
if (this.rawValue == null)
	sharedLib.hideIfVisible(zastupce_wrapper.druh_zastupce);
else
	sharedLib.visibleIfHidden(zastupce_wrapper.druh_zastupce);
</script>
