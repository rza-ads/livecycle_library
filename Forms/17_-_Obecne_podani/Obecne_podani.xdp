	//epodatelna.guid.rawValue = uuid_generator.createUUID();
}

if (this.rawValue == '0' || this.rawValue == null || this.rawValue == "") {
	sharedLib.hideIfVisible(epodatelna, true);
}
</script>
                     </event>
