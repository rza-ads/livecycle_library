function showIsDosahl(show, eraseContent) {
	//console.show();
	//console.println("showIsDosahl() 1 ");
	if (xfa.resolveNode("Formular.pohl_rov_za_maj_podstatou.wrapper.pohledavky_wrapper.pohledavky") ) {
		for (var i = 0; i &lt; Formular.pohl_rov_za_maj_podstatou.wrapper.pohledavky_wrapper.pohledavky._pohledavka_row.count; i++) {
			var obj = xfa.resolveNode("Formular.pohl_rov_za_maj_podstatou.wrapper.pohledavky_wrapper.pohledavky.pohledavka_row[" + i + "].pohledavka_row_tbl.Row2.wrapper.dosahlIS");
			if (show)
				sharedLib.visibleIfHidden(obj)
			else {
				if (eraseContent) {
					obj.rawValue = null;
				}
				sharedLib.hideIfVisible(obj, eraseContent)
			};
		}
		
	}
	//console.println("showIsDosahl() 2 ");
	if (xfa.resolveNode("Formular.pohl_za_maj_podstatou.wrapper.pohledavky_wrapper.pohledavky") ) {
		for (var i = 0; i &lt; Formular.pohl_za_maj_podstatou.wrapper.pohledavky_wrapper.pohledavky._pohledavka_row.count; i++) {
			var obj = xfa.resolveNode("Formular.pohl_za_maj_podstatou.wrapper.pohledavky_wrapper.pohledavky.pohledavka_row[" + i + "].pohledavka_row_tbl.Row2_B.wrapper.dosahlIS");
			if (show)
				sharedLib.visibleIfHidden(obj)
			else {
				if (eraseContent) {
					obj.rawValue = null;
				}
				sharedLib.hideIfVisible(obj, eraseContent)
			};
		}
		for (var i = 0; i &lt; Formular.pohl_za_maj_podstatou.wrapper.pohledavky_wrapper.pohledavky._pohledavka_row.count; i++) {
			var obj = xfa.resolveNode("Formular.pohl_za_maj_podstatou.wrapper.pohledavky_wrapper.pohledavky.pohledavka_row[" + i + "].pohledavka_row_tbl.Row2_AC.wrapper.dosahlIS");
			if (show)
				sharedLib.visibleIfHidden(obj)
			else {
				if (eraseContent) {
					obj.rawValue = null;
				}
				sharedLib.hideIfVisible(obj, eraseContent)
			};
		}
	}
}

function updateIsDosahl (obj, indexDeletedIS) {
	
	//var tmp = obj.rawValue;
	
	if (obj.rawValue == indexDeletedIS) obj.rawValue = null;
	if (obj.rawValue &gt; indexDeletedIS) obj.rawValue -= 1;

	//xfa.host.messageBox("Old: " + tmp + " index: " + indexDeletedIS + " new: " + obj.rawValue);
};
