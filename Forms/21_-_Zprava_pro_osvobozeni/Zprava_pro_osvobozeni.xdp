                                 <color value="51,51,51"/>
                              </fill>
                           </font>
                           <para vAlign="middle"/>
                        </caption>
                        <items>
                           <text>přiznat osvobození od placení zbývajících pohledávek a pokračovat v insolvenčním řízení</text>
                           <text>přiznat osvobození od placení zbývajících pohledávek a rozhodnout o splnění oddlužení</text>
                           <text>prodloužit průběh oddlužení</text>
                           <text>zrušit schválené oddlužení</text>
                        </items>
                        <items save="1" presence="hidden">
                           <text>1</text>
                           <text>2</text>
                           <text>3</text>
                           <text>4</text>
                        </items>
                        <event activity="initialize" name="event__initialize">
                           <script contentType="application/x-javascript">

if (this.rawValue == null || this.rawValue == 1 || this.rawValue == 2 ) {
	sharedLib.hideIfVisible(prodlouzeni, false);
}
if (this.rawValue == 3) {
	sharedLib.visibleIfHidden(prodlouzeni);
}
if (this.rawValue == 4) {
	sharedLib.hideIfVisible(prodlouzeni, false);
}
</script>
                        </event>
                        <event activity="exit" name="event__exit">
                           <script contentType="application/x-javascript">

if (this.rawValue == null || this.rawValue == 1 || this.rawValue == 2 ) {
	sharedLib.hideIfVisible(prodlouzeni, true);
	zrušeni._wrapper.setInstances(0);
}
if (this.rawValue == 3) {
	sharedLib.visibleIfHidden(prodlouzeni);
	zrušeni._wrapper.setInstances(0);
}
if (this.rawValue == 4) {
	sharedLib.hideIfVisible(prodlouzeni, true);
	zrušeni._wrapper.setInstances(1);
}
</script>
                        </event>
                     </field>
                     <subform w="190mm" minH="6mm" layout="lr-tb" name="zrušeni">
                        <bind match="none"/>
                        <subform w="190mm" minH="6mm" layout="lr-tb" name="wrapper">
                           <bind match="dataRef" ref="$.zruseni[*]"/>
                           <field name="duvod" w="175mm" h="6mm">
                              <ui>
                                 <choiceList>
                                    <border>
                                       <edge thickness="0.1mm">
                                          <color value="180,180,180"/>
                                       </edge>
                                       <corner thickness="0.1mm">
                                          <color value="180,180,180"/>
                                       </corner>
                                    </border>
                                 </choiceList>
                              </ui>
                              <font typeface="Myriad Pro">
                                 <fill>
                                    <color value="51,51,51"/>
                                 </fill>
                              </font>
                              <margin topInset="1mm" bottomInset="0mm" leftInset="2mm" rightInset="2mm"/>
                              <para marginLeft="2.835pt" marginRight="2.835pt" vAlign="middle" spaceAbove="2pt"/>
                              <bind match="dataRef" ref="$.duvod"/>
                              <assist>
                                 <speak priority="toolTip"/>
                              </assist>
                              <caption reserve="53.9733mm">
                                 <value>
                                    <text>Důvod zrušení schváleného oddlužení:</text>
                                 </value>
                                 <font typeface="Myriad Pro" size="9pt">
                                    <fill>
                                       <color value="51,51,51"/>
                                    </fill>
                                 </font>
                                 <para vAlign="middle"/>
                              </caption>
                              <items>
                                 <text>lze důvodně předpokládat, že oddlužením je sledován nepoctivý záměr</text>
                                 <text>dlužník neplní podstatné povinnosti podle schváleného způsobu oddlužení</text>
                                 <text>dlužníku vznikl nový závazek po splatnosti</text>
                                 <text>dlužník neplní minimální splátku v důsledku okolností, které zavinil</text>
                                 <text>dlužník neplní minimální splátku v důsledku nesplnění závazku třetí osoby</text>
                                 <text>dlužník neplní minimální splátku v rozporu se závazným příslibem</text>
                                 <text>dlužník neplní minimální splátku v důsledku zvýšení základní částky</text>
                                 <text>dlužník navrhl zrušení schváleného oddlužení</text>
                              </items>
                              <items save="1" presence="hidden">
                                 <text>1</text>
                                 <text>2</text>
                                 <text>3</text>
                                 <text>4</text>
                                 <text>5</text>
                                 <text>6</text>
                                 <text>7</text>
                                 <text>8</text>
                              </items>
                           </field>
                           <subform name="tlacitka" layout="lr-tb" h="0.275597in" w="0.472444in" hAlign="right">
                              <margin bottomInset="1mm" leftInset="1mm" rightInset="0mm" topInset="1mm"/>
                              <bind match="none"/>
                              <field relevant="-print" h="5mm" name="btnAdd" w="5mm" y="0mm">
                                 <border hand="right">
                                    <edge thickness="0.2mm">
                                       <color value="130,130,130"/>
                                    </edge>
                                    <corner thickness="0.201mm">
                                       <color value="130,130,130"/>
                                    </corner>
                                    <fill/>
                                 </border>
                                 <caption>
                                    <font typeface="Myriad Pro" size="12pt" weight="bold">
                                       <fill>
                                          <color value="77,114,149"/>
                                       </fill>
                                    </font>
                                    <para hAlign="center" vAlign="middle"/>
                                    <value>
                                       <text>+</text>
                                    </value>
                                 </caption>
                                 <font typeface="Myriad Pro"/>
                                 <ui>
                                    <button highlight="none"/>
                                 </ui>
                                 <bind match="none"/>
                                 <event activity="click" name="event__click">
                                    <script contentType="application/x-javascript">
 newIS = this.parent.parent.parent._wrapper.insertInstance(this.parent.parent.index + 1);
 
</script>
                                 </event>
                                 <assist>
                                    <toolTip>Přidá příjem podléhající výkonu rozhodnutí.</toolTip>
                                    <speak priority="toolTip"/>
                                 </assist>
                              </field>
                              <field relevant="-print" h="5mm" name="btnRemove" w="5mm" y="0mm">
                                 <border hand="right">
                                    <edge thickness="0.2mm">
                                       <color value="130,130,130"/>
                                    </edge>
                                    <corner thickness="0.2mm">
                                       <color value="130,130,130"/>
                                    </corner>
                                    <fill/>
                                 </border>
                                 <caption>
                                    <font typeface="Myriad Pro" size="12pt" weight="bold">
                                       <fill>
                                          <color value="251,85,91"/>
                                       </fill>
                                    </font>
                                    <para hAlign="center" vAlign="middle"/>
                                    <value>
                                       <text>−</text>
                                    </value>
                                 </caption>
                                 <font typeface="Myriad Pro"/>
                                 <ui>
                                    <button highlight="none"/>
                                 </ui>
                                 <bind match="none"/>
                                 <event activity="click" name="event__click">
                                    <script contentType="application/x-javascript">


if (this.parent.parent.parent._wrapper.count &lt;= 1) {
