                                 </edge>
                                 <corner thickness="0.2mm">
                                    <color value="130,130,130"/>
                                 </corner>
                              </border>
                              <bind match="dataRef" ref="$.mira"/>
                              <format>
                                 <picture>null{'%'}|zero{9' %'}|num{zzz zzz zz9.9999' %'}</picture>
                              </format>
                              <event activity="exit" name="event__exit">
                                 <script contentType="application/x-javascript">
localLib.setPrubehFromProc(this.rawValue, true);
if (this.rawValue &gt; 100) then {
	xfa.host.messageBox("Hodnota nesmí výt vyšší než 100.");
	xfa.host.setFocus(this);
}
</script>
                              </event>
                              <assist>
                                 <toolTip>Uveďte míru uspokojení přihlášených věřitelů bez ohledu na podřízené či nepodřízené části pohledávek.</toolTip>
                              </assist>
                              <event activity="initialize" name="event__initialize">
                                 <script contentType="application/x-javascript">
localLib.setPrubehFromProc(this.rawValue, false);
</script>
                              </event>
                           </field>
                           <para vAlign="middle" hAlign="center"/>
