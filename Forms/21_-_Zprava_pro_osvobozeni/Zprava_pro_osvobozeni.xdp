                                          <color value="180,180,180"/>
                                       </corner>
                                       <fill/>
                                    </border>
                                 </numericEdit>
                              </ui>
                              <font typeface="Myriad Pro">
                                 <fill>
                                    <color value="51,51,51"/>
                                 </fill>
                              </font>
                              <margin topInset="1mm" bottomInset="1mm" leftInset="1mm" rightInset="1mm"/>
                              <para vAlign="middle" marginLeft="2.835pt" marginRight="2.835pt" hAlign="right" spaceAbove="2pt"/>
