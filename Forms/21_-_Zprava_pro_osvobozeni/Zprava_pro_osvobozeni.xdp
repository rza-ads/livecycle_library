                           <subform layout="row" name="Row2_AC">
                              <assist role="TR"/>
                              <border>
                                 <edge presence="hidden"/>
                              </border>
                              <bind match="none"/>
                              <subform layout="lr-tb" name="wrapper" colSpan="-1" w="168mm">
                                 <bind match="none"/>
                                 <field h="6.85mm" name="druh_AC" w="143mm">
                                    <border>
                                       <corner thickness="0.2mm">
                                          <color value="130,130,130"/>
                                       </corner>
                                       <edge thickness="0.2mm">
                                          <color value="130,130,130"/>
                                       </edge>
                                    </border>
                                    <caption reserve="24mm">
                                       <font typeface="Myriad Pro" size="9pt">
                                          <fill>
                                             <color value="51,51,51"/>
                                          </fill>
                                       </font>
                                       <para vAlign="middle"/>
                                       <value>
                                          <text>Druh pohledávky</text>
                                       </value>
                                    </caption>
                                    <font typeface="Myriad Pro" size="8pt">
                                       <fill>
                                          <color value="51,51,51"/>
                                       </fill>
                                    </font>
                                    <margin bottomInset="1mm" leftInset="1mm" rightInset="1mm" topInset="1mm"/>
                                    <para marginLeft="2.835pt" marginRight="2.835pt" spaceAbove="2pt" vAlign="middle"/>
                                    <ui>
                                       <choiceList>
                                          <border>
                                             <corner thickness="0.1mm">
                                                <color value="180,180,180"/>
                                             </corner>
                                             <edge thickness="0.1mm">
                                                <color value="180,180,180"/>
                                             </edge>
                                          </border>
                                          <margin/>
                                       </choiceList>
                                    </ui>
                                    <bind ref="$.druh" match="dataRef"/>
                                    <assist>
                                       <toolTip>Uveďte o jaký druh pohledávky se jedná.</toolTip>
                                    </assist>
                                    <items>
                                       <text>1. Výdaje insolvenčního správce ze zpeněžení předmětu zajištění podle § 298 InsZ</text>
                                       <text>2. Náklady spojené s udržováním a správou majetkové podstaty dlužníka</text>
                                       <text>3. Daně, poplatky a jiná obdobná peněžitá plnění, pojistné na sociální zabezpečení a příspěvek na státní politiku zaměstnanosti, pojistné na veřejné zdravotní pojištění a pojistné na důchodové spoření, pohledávky vzniklé opravou výše daně u pohledávek za dlužníkem</text>
                                       <text>4. Náhrada zálohy na náklady insolvenčního řízení, jestliže ji v souladu s rozhodnutím insolvenčního soudu zaplatila jiná osoba než dlužník</text>
                                       <text>5. Náhrada hotových výdajů osob, které poskytly insolvenčnímu správci součinnost</text>
                                       <text>6. Pohledávky věřitelů ze smluv uzavřených osobou s dispozičními oprávněními</text>
                                       <text>7. Pohledávky věřitelů ze smluv, které se podle tohoto zákona považují za smlouvy, jejichž splnění osoba s dispozičními oprávněními neodmítla</text>
                                       <text>8. Pohledávky věřitelů odpovídající právu na vrácení plnění ze smluv, které se podle tohoto zákona považují za smlouvy, jejichž splnění osoba s dispozičními oprávněními odmítla</text>
                                       <text>9. Náhrada nutných výdajů a odměna členů a náhradníků věřitelského výboru</text>
                                       <text>10. Náhrada hotových výdajů a odměna znalce ustanoveného insolvenčním soudem za účelem ocenění majetkové podstaty</text>
                                       <text>11. Částka vyčleněná na předpokládané výlohy spojené s ukončením řízení podle § 305 odst. 3 InsZ</text>
                                       <text>12. Náhrada hotových výdajů předběžného správce</text>
                                       <text>13. Náhrada nutných výdajů a odměna likvidátora dlužníka jmenovaného soudem a správce podniku dlužníka za součinnost poskytnutou předběžnému správci nebo insolvenčnímu správci</text>
                                       <text>14. Pohledávky věřitelů vzniklé za trvání moratoria ze smluv podle § 122 odst. 2 InsZ</text>
                                       <text>15. Pohledávky věřitelů z úvěrového financování</text>
                                       <text>16. Náhrada nutných výdajů a odměna likvidátora, osoby v postavení obdobném postavení likvidátora a odpovědného zástupce za činnost prováděnou po rozhodnutí o úpadku</text>
                                       <text>17. Úroky podle § 171 odst. 4 InsZ</text>
                                       <text>18. Další pohledávky, o nichž tak stanoví InsZ</text>
                                    </items>
                                    <items save="1" presence="hidden">
                                       <text>1</text>
                                       <text>2</text>
                                       <text>3</text>
                                       <text>4</text>
                                       <text>5</text>
                                       <text>6</text>
                                       <text>7</text>
                                       <text>8</text>
                                       <text>9</text>
                                       <text>10</text>
                                       <text>11</text>
                                       <text>12</text>
                                       <text>13</text>
                                       <text>14</text>
                                       <text>15</text>
                                       <text>16</text>
                                       <text>17</text>
                                       <text>18</text>
                                    </items>
                                    <event activity="initialize" name="event__initialize">
                                       <script contentType="application/x-javascript">
localLib.setOnDruhPohl(pohledavka_row_tbl, insolvencni_spravce_dalsi.wrapper.rb_dalsi_ins_spravce.rawValue);
</script>
                                    </event>
                                 </field>
                                 <para vAlign="middle" hAlign="center"/>
                                 <field h="6.85mm" name="dosahlIS" w="0.98425in">
                                    <assist>
                                       <toolTip>Označte insolvenčního správce, který příjmu dosáhl.</toolTip>
                                    </assist>
                                    <border>
                                       <corner thickness="0.2mm">
                                          <color value="130,130,130"/>
                                       </corner>
                                       <edge thickness="0.2mm">
                                          <color value="130,130,130"/>
                                       </edge>
                                    </border>
                                    <font typeface="Myriad Pro">
                                       <fill>
                                          <color value="51,51,51"/>
                                       </fill>
                                    </font>
                                    <items>
                                       <text>IS1</text>
                                    </items>
                                    <items presence="hidden" save="1">
                                       <text>1</text>
                                    </items>
                                    <margin bottomInset="1mm" leftInset="1mm" rightInset="1mm" topInset="1mm"/>
                                    <para vAlign="middle" hAlign="center"/>
                                    <ui>
                                       <choiceList>
                                          <border>
                                             <corner thickness="0.1mm">
                                                <color value="180,180,180"/>
                                             </corner>
                                             <edge thickness="0.1mm">
                                                <color value="180,180,180"/>
                                             </edge>
                                          </border>
                                          <margin/>
                                       </choiceList>
                                    </ui>
                                    <bind ref="$.dosahlIS" match="dataRef"/>
                                    <caption reserve="5.649mm">
                                       <para vAlign="middle"/>
                                       <value>
                                          <text>IS:</text>
                                       </value>
                                       <font typeface="Myriad Pro" size="9pt">
                                          <fill>
                                             <color value="51,51,51"/>
                                          </fill>
                                       </font>
                                    </caption>
                                    <event activity="initialize" name="event__initialize">
                                       <script contentType="application/x-javascript">
localLib.setIsDosahlItems(this, this);
</script>
                                    </event>
                                 </field>
                                 <?templateDesigner expand 1?></subform>
                              <?templateDesigner expand 1?></subform>
