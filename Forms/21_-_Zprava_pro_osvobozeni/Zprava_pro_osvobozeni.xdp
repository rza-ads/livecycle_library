         <script usehref="..\..\Fragments\IsirLibStr.xdp#som($template.form1.#subform.#variables.IsirLibStr)"/>
         <script contentType="application/x-javascript" name="labels">
var texts = 
{
	dluznik1				: "Označení dlužníka:",
	dluznik2				: "Označení dlužnice:",

	dluznik_label1			: "II. Identifikace dlužníka",
	dluznik_label2			: "II. Identifikace dlužníků",

	shrnuti_zpenezeno_vse	: "V řízení byl zpeněžen veškerý majetek dlužníka:",
	shrnuti_zpenezeno_vse_multi	: "V řízení byl zpeněžen veškerý majetek dlužníků:",

	oddluzeni_3roky			: "Předpoklad uspokojení pohledávek nezajištěných věřitelů před schválením oddlužení na 3 roky (míra | výše)",
	oddluzeni_5let			: "Předpoklad uspokojení pohledávek nezajištěných věřitelů před schválením oddlužení na 5 let (míra | výše)",
	
	zprava					: "Zpráva o průběhu oddlužení včetně případných okolností a důvodů, které vedly ke krátkodobému neplnění splátkového kalendáře či k nižší míře uspokojení oproti míře předpokládané v rozhodnutí o schválení oddlužení.",
	zprava_100				: "Zpráva o průběhu oddlužení včetně případných okolností a důvodů, které vedly ke krátkodobému neplnění splátkového kalendáře.",
	
	vyse_dph				: "Výše včetně DPH",
	vyse_bez_dph			: "Výše bez DPH",
	
	odmena_nadpis_2019		: "Odměna za období trvání oddlužení (bez přerušení)",
	odmena_nadpis			: "Odměna za období trvání oddlužení",
	
	odmena_2019_neprerus	: "Pokud je způsobem řešení dlužníkova úpadku oddlužení plněním splátkového kalendáře se zpeněžením majetkové podstaty, činí odměna insolvenčního správce dle § 3 vyhlášky č. 313/2007 Sb., v rozhodném znění, 750 Kč za každý započatý kalendářní měsíc od rozhodnutí o povolení oddlužení do skončení plnění splátkového kalendáře. Tato měsíční částka odměny insolvenčního správce se zvýší o 50 %, jestliže jde o oddlužení povolené na základě společného návrhu manželů.",
	odmena_2019_prerus		: "Pokud je způsobem řešení dlužníkova úpadku oddlužení plněním splátkového kalendáře se zpeněžením majetkové podstaty, činí odměna insolvenčního správce dle § 3 vyhlášky č. 313/2007 Sb., v rozhodném znění, 750 Kč za každý započatý kalendářní měsíc od rozhodnutí o povolení oddlužení do skončení plnění splátkového kalendáře. Tato měsíční částka odměny insolvenčního správce se zvýší o 50 %, jestliže jde o oddlužení povolené na základě společného návrhu manželů. Po dobu přerušení průběhu oddlužení se měsíční částka o 70 % sníží.",
	
	// 20.7.2020 - MiD
	//odmena_2014			: "Pokud je způsobem řešení dlužníkova úpadku oddlužení plněním splátkového kalendáře, činí odměna insolvenčního správce dle § 3 vyhlášky č. 313/2007 Sb., v rozhodném znění, 750 Kč za každý započatý kalendářní měsíc od rozhodnutí o povolení oddlužení do skončení plnění splátkového kalendáře.",
	odmena_2014				: "Pokud je způsobem řešení dlužníkova úpadku oddlužení plněním splátkového kalendáře, činí odměna insolvenčního správce dle § 3 vyhlášky č. 313/2007 Sb., v rozhodném znění, 750 Kč a v případě oddlužení povoleného na základě společného návrhu manželů 1 125 Kč za každý započatý kalendářní měsíc od rozhodnutí o povolení oddlužení do skončení plnění splátkového kalendáře.",
	odmena_2013 			: "Pokud je způsobem řešení dlužníkova úpadku oddlužení plněním splátkového kalendáře, činí odměna insolvenčního správce dle § 3 vyhlášky č. 313/2007 Sb., v rozhodném znění, 750 Kč za každý započatý kalendářní měsíc trvání účinků schválení oddlužení plněním splátkového kalendáře.",
	
	hotove_vydaje_2019		: "Insolvenčnímu správci náleží dle § 7 odst. 4 vyhlášky č. 313/2007 Sb., v rozhodném znění, v souvislosti s výkonem jeho činnosti při oddlužení plněním splátkového kalendáře se zpeněžením majetkové podstaty náhrada hotových výdajů ve výši 150 Kč a v případě oddlužení povoleného na základě společného návrhu manželů 225 Kč za každý započatý kalendářní měsíc od rozhodnutí o povolení oddlužení do skončení plnění splátkového kalendáře.",	
	
	hotove_vydaje_2014		: "Insolvenčnímu správci náleží dle § 7 odst. 4 vyhlášky č. 313/2007 Sb., v rozhodném znění, v souvislosti s výkonem jeho činnosti při oddlužení plněním splátkového kalendáře náhrada hotových výdajů ve výši 150 Kč a v případě oddlužení povoleného na základě společného návrhu manželů 225 Kč za každý započatý kalendářní měsíc od rozhodnutí o povolení oddlužení do skončení plnění splátkového kalendáře.",
	hotove_vydaje_2013 		: "Insolvenčnímu správci náleží dle § 7 odst. 4 vyhlášky č. 313/2007 Sb., v rozhodném znění, v souvislosti s výkonem jeho činnosti při oddlužení plněním splátkového kalendáře náhrada hotových výdajů ve výši 150 Kč za každý započatý kalendářní měsíc trvání účinků schválení oddlužení plněním splátkového kalendáře.",	
};

function setIdentifikaceDluznikaTitle(pocetDluzniku) {
	sharedLib.setOnValueChange(Formular.dluznik.wrapper.label, pocetDluzniku&gt;1 ? texts.dluznik_label2 : texts.dluznik_label1);
	//Shrnuti
	sharedLib.setOnValueChange(Formular.shrnuti_rizeni.wrapper.shrnuti.zpenezeno_vse.text,  pocetDluzniku&gt;1 ? texts.shrnuti_zpenezeno_vse_multi : texts.shrnuti_zpenezeno_vse);
		
};

function setTextOdmena (oDatumUsneseni, oSwitchPreruseno) {
	if (sharedLib.compareDates(oDatumUsneseni, "2019-06-01") &gt;= 0) {
		if (oSwitchPreruseno.rawValue == 1) {
			sharedLib.setOnValueChange(Formular.detail_vyuctovani.wrapper.odmena_a_hotove_vydaje.odmena_trvani.wrapper.text, labels.texts.odmena_2019_prerus);
		}
		else {
			sharedLib.setOnValueChange(Formular.detail_vyuctovani.wrapper.odmena_a_hotove_vydaje.odmena_trvani.wrapper.text, labels.texts.odmena_2019_neprerus);
		};
	}
	else {
		if (sharedLib.compareDates(oDatumUsneseni, "2014-01-01") &gt;= 0) {
			sharedLib.setOnValueChange(Formular.detail_vyuctovani.wrapper.odmena_a_hotove_vydaje.odmena_trvani.wrapper.text, labels.texts.odmena_2014);
		}
		else {
			sharedLib.setOnValueChange(Formular.detail_vyuctovani.wrapper.odmena_a_hotove_vydaje.odmena_trvani.wrapper.text, labels.texts.odmena_2013);
		}
	};
};
</script>
         <script contentType="application/x-javascript" name="localLib">
/*spokojeni_veritelu

	Aktualizuje layout formuláře podle hodnoty pople upadek_ze_dne
	Při hodnotě parametru eraseContent = true se skrývaným polím vymažou hodnoty.
*/
function updateFromDatumUsneseni(usneseniDate, eraseContent) {

	
	if (sharedLib.isDate(usneseniDate)) {
		sharedLib.visibleIfHidden(Formular.prubeh_rizeni);
		sharedLib.visibleIfHidden(Formular.vyuctovani);
		sharedLib.visibleIfHidden(Formular.detail_vyuctovani);
	} else {
		sharedLib.hideIfVisible(Formular.prubeh_rizeni, eraseContent);
		sharedLib.hideIfVisible(Formular.vyuctovani, eraseContent);
		sharedLib.hideIfVisible(Formular.detail_vyuctovani, eraseContent);
		sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.oddluzeni_dle_412, eraseContent);
		return;
	}

	// pro usneseni &gt;= 01.06.2019
	if (sharedLib.compareDates(usneseniDate, "2019-06-01") &gt;= 0) {
		
		// Shrnuti ins. rizeni	
		sharedLib.visibleIfHidden(Formular.shrnuti_rizeni.wrapper.shrnuti.oddluzeni_dle_412);
		
		sharedLib.visibleIfHidden(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_header_2019);
		//sharedLib.visibleIfHidden(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_2019);
		Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table._predpoklad_uspokojeni_veritelu_2019.setInstances(1);
		
		sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_header, false);	
		//sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu, eraseContent);
		Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table._predpoklad_uspokojeni_veritelu.setInstances(0);
		
		sharedLib.visibleIfHidden(Formular.shrnuti_rizeni.wrapper.shrnuti.oddluzeni_preruseno);
		sharedLib.visibleIfHidden(Formular.shrnuti_rizeni.wrapper.shrnuti.oddluzeni_prodlouzeno);
		
		// Prubeh ins. rizeni	
		sharedLib.visibleIfHidden(Formular.prubeh_rizeni.wrapper.doporuceni_ins_spravce.doporuceni_1);	

		
		// Vyuctovani
		sharedLib.setOnValueChange(Formular.detail_vyuctovani.wrapper.odmena_a_hotove_vydaje.odmena_trvani.wrapper.label, labels.texts.odmena_nadpis_2019);
		sharedLib.setOnValueChange(Formular.detail_vyuctovani.wrapper.odmena_a_hotove_vydaje.hotove_vydaje.wrapper.text, labels.texts.hotove_vydaje_2019);
		
		sharedLib.visibleIfHidden(Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_pausal);
		sharedLib.visibleIfHidden(Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_prezkum);
			
		sharedLib.hideIfVisible(Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_realizace, eraseContent &amp;&amp; Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_realizace.zalohove_neuhrazeno.rawValue != 0);
		sharedLib.hideIfVisible(Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_meziobdobi, eraseContent &amp;&amp; Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_meziobdobi.zalohove_neuhrazeno.rawValue != 0);
		
		sharedLib.hideIfVisible(Formular.detail_vyuctovani.wrapper.odmena_a_hotove_vydaje_pred_splacenim, eraseContent);
	} 
	// pro usneseni &lt;01.01.2014;31.05.2019&gt;
	else if (sharedLib.compareDates(usneseniDate, "2014-01-01") &gt;= 0) {
		
		// Shrnuti ins. rizeni	
		sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.oddluzeni_dle_412, eraseContent);
	
		sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_header_2019, false);
		//sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_2019, eraseContent);	
		Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table._predpoklad_uspokojeni_veritelu_2019.setInstances(0);
		
		sharedLib.visibleIfHidden(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_header);
		//sharedLib.visibleIfHidden(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu);
		Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table._predpoklad_uspokojeni_veritelu.setInstances(1);
		
		sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.oddluzeni_preruseno, eraseContent);
		sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.oddluzeni_prodlouzeno, eraseContent);
		
		// Prubeh ins. rizeni
		sharedLib.hideIfVisible(Formular.prubeh_rizeni.wrapper.doporuceni_ins_spravce.doporuceni_1, eraseContent);
		
		// Vyuctovani
		sharedLib.setOnValueChange(Formular.detail_vyuctovani.wrapper.odmena_a_hotove_vydaje.odmena_trvani.wrapper.label, labels.texts.odmena_nadpis);
		sharedLib.setOnValueChange(Formular.detail_vyuctovani.wrapper.odmena_a_hotove_vydaje.hotove_vydaje.wrapper.text, labels.texts.hotove_vydaje_2014);
		
		sharedLib.visibleIfHidden(Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_pausal);
		
		if (sharedLib.compareDates(usneseniDate, "2017-07-01") &gt;= 0)
			sharedLib.visibleIfHidden(Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_prezkum);
		else
			sharedLib.hideIfVisible(Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_prezkum, eraseContent &amp;&amp; Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_prezkum.zalohove_neuhrazeno.rawValue != 0);
			
		sharedLib.hideIfVisible(Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_realizace, eraseContent &amp;&amp; Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_realizace.zalohove_neuhrazeno.rawValue != 0);
		sharedLib.hideIfVisible(Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_meziobdobi, eraseContent &amp;&amp; Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_meziobdobi.zalohove_neuhrazeno.rawValue != 0);
		
		sharedLib.hideIfVisible(Formular.detail_vyuctovani.wrapper.odmena_a_hotove_vydaje_pred_splacenim, eraseContent);
	} 
	// pro usneseni &lt;= 31.12.2013
	else {
	
		// Shrnuti ins. rizeni	
		sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.oddluzeni_dle_412, eraseContent);
		
		sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_header_2019, false);
		//sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_2019, eraseContent);	
		Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table._predpoklad_uspokojeni_veritelu_2019.setInstances(0);
		
		sharedLib.visibleIfHidden(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_header);
		//sharedLib.visibleIfHidden(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu);
		Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table._predpoklad_uspokojeni_veritelu.setInstances(1);
		
		sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.oddluzeni_preruseno, eraseContent);
		sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.oddluzeni_prodlouzeno, eraseContent);
		
		// Prubeh ins. rizeni
		sharedLib.hideIfVisible(Formular.prubeh_rizeni.wrapper.doporuceni_ins_spravce.doporuceni_1, eraseContent);
		
		// Vyuctovani
		sharedLib.setOnValueChange(Formular.detail_vyuctovani.wrapper.odmena_a_hotove_vydaje.odmena_trvani.wrapper.label, labels.texts.odmena_nadpis);
		sharedLib.setOnValueChange(Formular.detail_vyuctovani.wrapper.odmena_a_hotove_vydaje.hotove_vydaje.wrapper.text, labels.texts.hotove_vydaje_2013);
		
		sharedLib.hideIfVisible(Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_pausal, eraseContent &amp;&amp; Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_pausal.zalohove_neuhrazeno.rawValue != 0);
		sharedLib.hideIfVisible(Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_prezkum, eraseContent &amp;&amp; Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_prezkum.zalohove_neuhrazeno.rawValue != 0);
		
		sharedLib.visibleIfHidden(Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_realizace);
		sharedLib.visibleIfHidden(Formular.vyuctovani.wrapper.odmena_ins_spravce_wrapper.odmena_ins_spravce.odmena_meziobdobi);
		
		sharedLib.visibleIfHidden(Formular.detail_vyuctovani.wrapper.odmena_a_hotove_vydaje_pred_splacenim);
	}

	labels.setTextOdmena (usneseniDate, Formular.shrnuti_rizeni.wrapper.shrnuti.oddluzeni_preruseno.oddluzeni_preruseno)
}

/*
	Aktualizuje layout formuláře podle hodnoty pole oddluzeni_412
*/
function updateFromOddluzeni412(oddluzeniValue, eraseContent) {
	// 1 - odst. 1 písm. a)
	if (oddluzeniValue == "1") {	
		// Shrnuti ins. rizeni
		sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_header_2019, false);
		//sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_2019, eraseContent);
		Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table._predpoklad_uspokojeni_veritelu_2019.setInstances(0);
		
		sharedLib.visibleIfHidden(Formular.shrnuti_rizeni.wrapper.shrnuti.oddluzeni_prodlouzeno);
		
		if (Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.uspokojeni_veritelu.nezajisteni.mira.rawValue == "" || Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.uspokojeni_veritelu.nezajisteni.mira.rawValue == null)
			Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.uspokojeni_veritelu.nezajisteni.mira.rawValue = 100,0000;
		
		//Prubeh ins. rizeni
		sharedLib.hideIfVisible(Formular.prubeh_rizeni.wrapper.dolozeni_duchod, eraseContent);
		sharedLib.visibleIfHidden(Formular.prubeh_rizeni.wrapper.zprava);
		sharedLib.setOnValueChange(Formular.prubeh_rizeni.wrapper.zprava.text, labels.texts.zprava_100);
	}
	// 2; 5 - odst. 1 písm. b); odst. 6
	else if (oddluzeniValue == "2" || oddluzeniValue == "5") {
		// Shrnuti ins. rizeni
		sharedLib.visibleIfHidden(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_header_2019);
		//sharedLib.visibleIfHidden(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_2019);
		Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table._predpoklad_uspokojeni_veritelu_2019.setInstances(1);
		
		sharedLib.setOnValueChange(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_2019.label, labels.texts.oddluzeni_3roky);
		
		sharedLib.visibleIfHidden(Formular.shrnuti_rizeni.wrapper.shrnuti.oddluzeni_prodlouzeno);
		
		if (Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.uspokojeni_veritelu.nezajisteni.mira.rawValue == 100)
			Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.uspokojeni_veritelu.nezajisteni.mira.rawValue = null;
		
		//Prubeh ins. rizeni
		sharedLib.hideIfVisible(Formular.prubeh_rizeni.wrapper.dolozeni_duchod, eraseContent);
		sharedLib.visibleIfHidden(Formular.prubeh_rizeni.wrapper.zprava);
		sharedLib.setOnValueChange(Formular.prubeh_rizeni.wrapper.zprava.text, labels.texts.zprava);
	}
	// 3 - odst. 1 písm. c)
	else if (oddluzeniValue == "3") {
		// Shrnuti ins. rizeni
		sharedLib.visibleIfHidden(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_header_2019);
		//sharedLib.visibleIfHidden(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_2019);
		Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table._predpoklad_uspokojeni_veritelu_2019.setInstances(1);
		
		sharedLib.setOnValueChange(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_2019.label, labels.texts.oddluzeni_5let);
	
		sharedLib.visibleIfHidden(Formular.shrnuti_rizeni.wrapper.shrnuti.oddluzeni_prodlouzeno);
		
		if (Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.uspokojeni_veritelu.nezajisteni.mira.rawValue == 100)
			Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.uspokojeni_veritelu.nezajisteni.mira.rawValue = null;
		
		//Prubeh ins. rizeni
		sharedLib.hideIfVisible(Formular.prubeh_rizeni.wrapper.dolozeni_duchod, eraseContent);		
		setPrubehFromProc(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.uspokojeni_veritelu.nezajisteni.mira.rawValue, eraseContent);
	}
	// 4 - odst. 4 nebo prázdná hodnota
	else if (oddluzeniValue == "4") {
		// Shrnuti ins. rizeni
		sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_header_2019, false);
		//sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_2019, eraseContent);
		Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table._predpoklad_uspokojeni_veritelu_2019.setInstances(0);
		
		sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.oddluzeni_prodlouzeno, eraseContent);
		
		if (Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.uspokojeni_veritelu.nezajisteni.mira.rawValue == 100)
			Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.uspokojeni_veritelu.nezajisteni.mira.rawValue = null;
		
		//Prubeh ins. rizeni
		sharedLib.visibleIfHidden(Formular.prubeh_rizeni.wrapper.dolozeni_duchod);
		sharedLib.visibleIfHidden(Formular.prubeh_rizeni.wrapper.zprava);
		sharedLib.setOnValueChange(Formular.prubeh_rizeni.wrapper.zprava.text, labels.texts.zprava);
	}
	// default
	else {
		// Shrnuti ins. rizeni
		sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_header_2019, false);
		//sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.predpoklad_uspokojeni_veritelu_2019, eraseContent);
		Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table._predpoklad_uspokojeni_veritelu_2019.setInstances(0);
		
		sharedLib.hideIfVisible(Formular.shrnuti_rizeni.wrapper.shrnuti.oddluzeni_prodlouzeno, eraseContent);
		
		if (Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.uspokojeni_veritelu.nezajisteni.mira.rawValue == 100,0000)
			Formular.shrnuti_rizeni.wrapper.shrnuti.shrnuti_table.uspokojeni_veritelu.nezajisteni.mira.rawValue = null;
		
		//Prubeh ins. rizeni
		sharedLib.hideIfVisible(Formular.prubeh_rizeni.wrapper.dolozeni_duchod, eraseContent);
		sharedLib.visibleIfHidden(Formular.prubeh_rizeni.wrapper.zprava);
		sharedLib.setOnValueChange(Formular.prubeh_rizeni.wrapper.zprava.text, labels.texts.zprava);
	}	
}

/*
	Aktualizuje sekci prubeh_rizeni podle hodnoty pole uspokojeni_veritelu.nezajisteni.mira
*/
function setPrubehFromProc(uspokojeni_proc, eraseContent) {
	if (uspokojeni_proc != null &amp;&amp; uspokojeni_proc &lt; 30) {
		sharedLib.hideIfVisible(Formular.prubeh_rizeni.wrapper.zprava, eraseContent);
	} else {
		sharedLib.visibleIfHidden(Formular.prubeh_rizeni.wrapper.zprava);
		sharedLib.setOnValueChange(Formular.prubeh_rizeni.wrapper.zprava.text, labels.texts.zprava);
	}
}

/*
	Zvaliduje hodnotu pole zalohove_neuhrazeno. 
	Pokud je hodnota vyssi, nez u referencniho pole, zobrazi hlasku a vynuti focus.
*/
function validateZalohoveNeuhrazeno(zalohove_neuhrazeno, vyse) {
	if (zalohove_neuhrazeno.rawValue &gt; vyse.rawValue) {
		xfa.host.messageBox("Neuhrazená část nesmí být vyšší, než stanovená odměna.", "Chybná hodnota pole");
		xfa.host.setFocus(zalohove_neuhrazeno);
	};
}

/*
	Zvaliduje hodnotu pole uspokojit zbyva. 
	Pokud je hodnota vyssi, nez u referencniho pole, zobrazi hlasku a vynuti focus.
*/
function validateZbyva(zbyva, vyse) {
	if (zbyva.rawValue &gt; vyse.rawValue) {
		xfa.host.messageBox("Částka uspokojit zbývá nesmí být vyšší, než stanovená odměna.", "Chybná hodnota pole");
		xfa.host.setFocus(zbyva);
	};
}




function setOnDruhPohl(viceInsSp) {
	//console.show();
	//console.println("setOnDruhPohl()");
	
	if (xfa.resolveNode("Formular.pohl_za_maj_podstatou.wrapper.pohledavky_wrapper.pohledavky")) {
		
            for (var i=0; i &lt; Formular.pohl_za_maj_podstatou.wrapper.pohledavky_wrapper.pohledavky._pohledavka_row.count; i++) {
                oPohledavka_row_tbl = xfa.resolveNode ("Formular.pohl_za_maj_podstatou.wrapper.pohledavky_wrapper.pohledavky.pohledavka_row[" + i + "].pohledavka_row_tbl") ;
                if  (viceInsSp  == 1) {
                    sharedLib.hideIfVisible(oPohledavka_row_tbl.Row2_AC, false);
            	    sharedLib.visibleIfHidden(oPohledavka_row_tbl.Row2_B);
                }
                else {
            	    sharedLib.hideIfVisible(oPohledavka_row_tbl.Row2_B, false);
            	    sharedLib.visibleIfHidden(oPohledavka_row_tbl.Row2_AC);
                }  
      			
            }
        
//    oPohledavka_row_tbl.execInitialize();
    };
	
}



function updateIsDosahl_all(indexDeletedIS) {
	//console.show();
	//console.println("updateIsDosahl_all()");
	
	if (xfa.resolveNode("Formular.pohl_za_maj_podstatou.wrapper.pohledavky_wrapper.pohledavky.pohledavka_row.pohledavka_row_tbl") ) {
		for (i = 0; i &lt; Formular.pohl_za_maj_podstatou.wrapper.pohledavky_wrapper.pohledavky._pohledavka_row.count; i++) {
			obj = xfa.resolveNode("Formular.pohl_za_maj_podstatou.wrapper.pohledavky_wrapper.pohledavky.pohledavka_row["+i+"]").pohledavka_row_tbl.Row2_AC.wrapper.dosahlIS ;
			try {
				updateIsDosahl (obj, indexDeletedIS);
			}
			catch (err) {
				  xfa.host.messageBox (err.toString());
			}
			obj = xfa.resolveNode("Formular.pohl_za_maj_podstatou.wrapper.pohledavky_wrapper.pohledavky.pohledavka_row["+i+"]").pohledavka_row_tbl.Row2_B.wrapper.dosahlIS ;
			try {
				updateIsDosahl (obj, indexDeletedIS);
			}
			catch (err) {
				  xfa.host.messageBox (err.toString());
			}
		};
	};
	if (xfa.resolveNode("Formular.pohl_rov_za_maj_podstatou.wrapper.pohledavky_wrapper.pohledavky.pohledavka_row") ) {	
		for (i = 0; i &lt; Formular.pohl_rov_za_maj_podstatou.wrapper.pohledavky_wrapper._pohledavky.count; i++) {
			obj = xfa.resolveNode("Formular.pohl_rov_za_maj_podstatou.wrapper.pohledavky_wrapper.pohledavky["+i+"]").pohledavka_row.pohledavka_row_tbl.Row2.wrapper.dosahlIS ;
			try {
				updateIsDosahl (obj, indexDeletedIS);
			}
			catch (err) {
				  xfa.host.messageBox (err.toString());
			}
		}
	};

};


function setIsDosahlItems(obj, hideObj) {
	//console.show();
	//console.println("setIsDosahlItems()");
	

	var lastVal = obj.rawValue;
	obj.clearItems();
	obj.addItem("IS1", "1");
	if (xfa.resolveNode("Formular.insolvencni_spravce_dalsi.wrapper.dalsi_ins_spravce_wrapper")) {
		for (var i=0; i &lt; Formular.insolvencni_spravce_dalsi.wrapper._dalsi_ins_spravce_wrapper.count; i++) {
				var bound = "" + (i + 2);
				var txt = "IS" + bound ;		
				//xfa.host.messageBox(txt);
				obj.addItem(txt, bound);
		};
	}
	else {
		sharedLib.hideIfVisible(hideObj, true);
	};
}

