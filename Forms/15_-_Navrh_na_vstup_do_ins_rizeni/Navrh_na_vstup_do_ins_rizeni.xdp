function PreSignCheck_local() {

	//	if (xfa.event.cancelAction != 1) sharedLib.visibleIfHidden(Formular.podpis.wrapper.podpisy.podpis1.podpisove_misto.wrapper);
	if (sharedLib.excMaxAttachSize(event.target)) {
	  app.alert("Je překročena maximální povolená celková velikost příloh "+sharedLib.MAX_ATT_DOCS_SIZE+" MB!");
	  xfa.event.cancelAction = 1;
	}
	
	if (xfa.event.cancelAction != 1) {
		var r = new RegExp(); 
		var message = "";
	
		r.compile ("^[2-9a-km-np-z]{7}$");
	

		oIDDS = xfa.resolveNode("Formular.veritel_novy.wrapper.veritel.fyzicka_osoba.jiny_kontakt_wrapper_veritel.jiny_kontakt_veritel.idds");
		if( oIDDS != null &amp;&amp; r.test(oIDDS.rawValue) == "0" &amp;&amp; oIDDS.rawValue != null &amp;&amp; oIDDS.rawValue != "") {
			message += "Chybně zadaný údaj Datová schránka nového věřitele.\n";
		};
			
		
		oIDDS = xfa.resolveNode("Formular.veritel_novy.wrapper.veritel.pravnicka_osoba.jiny_kontakt_wrapper_veritel.jiny_kontakt_veritel.idds");
		if( oIDDS != null &amp;&amp; r.test(oIDDS.rawValue) == "0" &amp;&amp; oIDDS.rawValue != null &amp;&amp; oIDDS.rawValue != "") {
			message += "Chybně zadaný údaj Datová schránka nového věřitele.\n";
		};
			
		oIDDS = xfa.resolveNode("Formular.veritel_novy.wrapper.zastupce_wrapper.zastupce.fyzicka_osoba.jiny_kontakt_wrapper_veritel.jiny_kontakt_veritel.idds");
		if( oIDDS != null &amp;&amp; r.test(oIDDS.rawValue) == "0" &amp;&amp; oIDDS.rawValue != null &amp;&amp; oIDDS.rawValue != "") {
			message += "Chybně zadaný údaj Datová schránka zástupce nového věřitele.\n";
			
		};
			
					
		oIDDS = xfa.resolveNode("Formular.veritel_novy.wrapper.zastupce_wrapper.zastupce.pravnicka_osoba.jiny_kontakt_wrapper_veritel.jiny_kontakt_veritel.idds");
		if( oIDDS != null &amp;&amp; r.test(oIDDS.rawValue) == "0" &amp;&amp; oIDDS.rawValue != null &amp;&amp; oIDDS.rawValue != "") {
			message += "Chybně zadaný údaj Datová schránka zástupce nového věřitele.\n";
			
		};
	
		if (message != "") {
			xfa.host.messageBox(message);
			xfa.event.cancelAction = 1;
		};
	}
	
//	if (xfa.event.cancelAction != 1) sharedLib.FillAllChildFields(ELZD.Formular, 0);
};
