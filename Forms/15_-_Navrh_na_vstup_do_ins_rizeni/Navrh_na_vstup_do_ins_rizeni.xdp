                           </field>
                           <field h="9mm" name="datum_narozeni" w="41mm">
                              <assist>
                                 <speak priority="toolTip"/>
                                 <toolTip>Uveďte datum narození.</toolTip>
                              </assist>
                              <caption placement="top" reserve="3.1mm">
                                 <font typeface="Myriad Pro" size="8pt">
                                    <fill>
                                       <color value="91,91,93"/>
                                    </fill>
                                 </font>
                                 <para marginLeft="2.835pt" marginRight="2.835pt"/>
                                 <value>
                                    <text>Datum narození:</text>
                                 </value>
                              </caption>
                              <font typeface="Myriad Pro">
                                 <fill>
                                    <color value="51,51,51"/>
                                 </fill>
                              </font>
                              <margin bottomInset="0.5mm" leftInset="1mm" rightInset="1mm" topInset="0.5mm"/>
                              <para marginLeft="2.835pt" marginRight="2.835pt" spaceAbove="0pt" vAlign="middle"/>
                              <ui>
                                 <picture>null{}|date{D.M.YYYY}</picture>
                                 <dateTimeEdit hScrollPolicy="off">
                                    <border>
                                       <corner thickness="0.1mm">
                                          <color value="180,180,180"/>
                                       </corner>
                                       <edge thickness="0.1mm">
                                          <color value="180,180,180"/>
                                       </edge>
                                    </border>
                                    <margin/>
                                 </dateTimeEdit>
                              </ui>
                              <bind ref="$.datum_narozeni" match="dataRef">
                                 <picture>null{}</picture>
                              </bind>
                              <format>
                                 <picture>null{}|date{D.M.YYYY}</picture>
                              </format>
                              <validate formatTest="error" scriptTest="warning">
                                 <picture>null{}|date{D.M.YYYY}</picture>
                                 <message>
                                    <text name="scriptTest"/>
                                    <text name="formatTest">Chybně vyplněné datum narození. Datum zadejte ve formátu d.m.rrrr.</text>
                                 </message>
                              </validate>
                              <value>
                                 <date/>
                              </value>
                              <event activity="change" name="event__change">
                                 <script contentType="application/x-javascript">
if (xfa.event.newText.match(/[^0-9\.]/)) {
	xfa.event.change = "";
}
</script>
                              </event>
                              <event activity="exit" name="event__exit">
                                 <script contentType="application/x-javascript">
if (this.errorText != "") {
	xfa.host.setFocus(this);
}
</script>
                              </event>
                           </field>
                           <field h="9mm" name="rodne_cislo" w="41mm">
                              <assist>
                                 <speak priority="toolTip"/>
                                 <toolTip>Uveďte rodné číslo. Není-li rodné číslo přiděleno, nevyplňujte.</toolTip>
                              </assist>
                              <caption placement="top" reserve="3.1mm">
                                 <font typeface="Myriad Pro" size="8pt">
                                    <fill>
                                       <color value="91,91,93"/>
                                    </fill>
                                 </font>
                                 <para marginLeft="2.835pt" marginRight="2.835pt"/>
                                 <value>
                                    <text>Rodné číslo:</text>
                                 </value>
                              </caption>
                              <font typeface="Myriad Pro">
                                 <fill>
                                    <color value="51,51,51"/>
                                 </fill>
                              </font>
                              <margin bottomInset="0.5mm" leftInset="1mm" rightInset="1mm" topInset="0.5mm"/>
                              <para marginLeft="2.835pt" marginRight="2.835pt" spaceAbove="0pt" vAlign="middle"/>
                              <ui>
                                 <picture>null{}|text{999999/999}|text{999999/9999}</picture>
                                 <textEdit>
                                    <border>
                                       <corner thickness="0.1mm">
                                          <color value="180,180,180"/>
                                       </corner>
                                       <edge thickness="0.1mm">
                                          <color value="180,180,180"/>
                                       </edge>
                                    </border>
                                    <margin/>
                                 </textEdit>
                              </ui>
                              <bind ref="$.rodne_cislo" match="dataRef">
                                 <picture>null{}|text{999999/999}|text{999999/9999}</picture>
                              </bind>
                              <format>
                                 <picture>null{}|text{999999/999}|text{999999/9999}</picture>
                              </format>
                              <value>
                                 <text maxChars="11"/>
                              </value>
                              <event activity="change" name="event__change">
                                 <script contentType="application/x-javascript">
if (xfa.event.newText.match(/[^0-9\/]/)) {
	xfa.event.change = "";
}
</script>
                              </event>
                              <event activity="exit" name="event__exit">
                                 <script contentType="application/x-javascript">
if (! validateRCLib.validateRC(this.rawValue)) {
	xfa.host.messageBox("Neplatné rodné číslo.");
	xfa.host.setFocus(this);
};
</script>
                              </event>
                           </field>
                           <subform layout="lr-tb" minH="9mm" w="41mm" x="82mm" y="9mm">
                              <bind match="none"/>
                              <?templateDesigner expand 1?></subform>
                           <field h="9mm" name="ico" w="41mm">
                              <assist>
                                 <speak priority="toolTip"/>
                                 <toolTip>Uveďte identifikační číslo, pokud bylo přiděleno.</toolTip>
                              </assist>
                              <caption placement="top" reserve="3.1mm">
                                 <font typeface="Myriad Pro" size="8pt">
                                    <fill>
                                       <color value="91,91,93"/>
                                    </fill>
                                 </font>
                                 <para marginLeft="2.835pt" marginRight="2.835pt" spaceAbove="0pt" spaceBelow="0pt"/>
                                 <value>
                                    <text>IČO:</text>
                                 </value>
                              </caption>
                              <font typeface="Myriad Pro">
                                 <fill>
                                    <color value="51,51,51"/>
                                 </fill>
                              </font>
                              <margin bottomInset="0.5mm" leftInset="1mm" rightInset="1mm" topInset="0.5mm"/>
                              <para marginLeft="2.835pt" marginRight="2.835pt" spaceAbove="0pt" vAlign="middle"/>
                              <ui>
                                 <picture>text{99999999}</picture>
                                 <textEdit>
                                    <border>
                                       <corner thickness="0.1mm">
                                          <color value="180,180,180"/>
                                       </corner>
                                       <edge thickness="0.1mm">
                                          <color value="180,180,180"/>
                                       </edge>
                                    </border>
                                    <margin/>
                                 </textEdit>
                              </ui>
                              <bind ref="$.osoba.ico" match="dataRef">
                                 <picture>text{99999999}</picture>
                              </bind>
                              <format>
                                 <picture>text{999 99 999}</picture>
                              </format>
                              <value>
                                 <text maxChars="8"/>
                              </value>
                              <event activity="change" name="event__change">
                                 <script contentType="application/x-javascript">
if (xfa.event.newText.match(/[^0-9]/)) {
	xfa.event.change = "";
}
</script>
                              </event>
                           </field>
                           <?templateDesigner expand 1?></subform>
                        <?templateDesigner expand 1?></subform>
