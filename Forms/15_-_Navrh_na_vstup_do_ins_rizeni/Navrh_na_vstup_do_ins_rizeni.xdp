                                 <text>Fyzická osoba</text>
                              </value>
                           </caption>
                           <font typeface="Myriad Pro">
                              <fill>
                                 <color value="251,85,91"/>
                              </fill>
                           </font>
                           <items>
                              <text>1</text>
                           </items>
                           <margin leftInset="1mm" rightInset="1mm"/>
                           <para vAlign="middle"/>
                           <ui>
                              <checkButton shape="round" size="3.8806mm">
                                 <border>
                                    <corner thickness="0.2mm">
                                       <color value="130,130,130"/>
                                    </corner>
                                    <edge thickness="0.2mm">
                                       <color value="130,130,130"/>
                                    </edge>
                                    <fill/>
                                 </border>
                                 <margin/>
                              </checkButton>
                           </ui>
                           <bind match="none"/>
                        </field>
                        <field h="7mm" name="pravnicka" w="47mm">
                           <caption placement="right" reserve="38mm">
                              <font typeface="Myriad Pro">
                                 <fill>
                                    <color value="51,51,51"/>
                                 </fill>
                              </font>
                              <para spaceAbove="1pt" vAlign="middle"/>
                              <value>
                                 <text>Právnická osoba</text>
                              </value>
                           </caption>
                           <font typeface="Myriad Pro">
                              <fill>
                                 <color value="251,85,91"/>
                              </fill>
                           </font>
                           <items>
                              <text>2</text>
                           </items>
                           <margin leftInset="1mm" rightInset="1mm"/>
                           <para vAlign="middle"/>
                           <ui>
                              <checkButton shape="round" size="3.8806mm">
                                 <border>
                                    <corner thickness="0.2mm">
                                       <color value="130,130,130"/>
                                    </corner>
                                    <edge thickness="0.2mm">
                                       <color value="130,130,130"/>
                                    </edge>
                                    <fill/>
                                 </border>
                                 <margin/>
                              </checkButton>
                           </ui>
                           <bind match="none"/>
                        </field>
                        <event activity="change" name="event__change">
                           <script contentType="application/x-javascript">

if (this.rawValue == null)
	sharedLib.hideIfVisible(zastupce_wrapper.druh_zastupce);
else
	sharedLib.visibleIfHidden(zastupce_wrapper.druh_zastupce);
	
// fyzicka
if (this.rawValue == '1') {
	this.parent.parent._pravnicka_osoba.setInstances(0);
	this.parent.parent._fyzicka_osoba.addInstance(1);
	// TODO: pridat dve instance, kdyz je spolecne oddluzeni
	
}

// pravnicka
if (this.rawValue == '2') {
	this.parent.parent._fyzicka_osoba.setInstances(0);
	this.parent.parent._pravnicka_osoba.addInstance(1);
}

</script>
                        </event>
                        <?templateDesigner itemValuesSpecified 1?>
                        <event activity="initialize" name="event__initialize">
                           <script contentType="application/x-javascript" runAt="both">


if (this.rawValue == null)
	sharedLib.hideIfVisible(zastupce_wrapper.druh_zastupce);
else
	sharedLib.visibleIfHidden(zastupce_wrapper.druh_zastupce);
</script>
                        </event>
                        <?templateDesigner expand 1?></exclGroup>
