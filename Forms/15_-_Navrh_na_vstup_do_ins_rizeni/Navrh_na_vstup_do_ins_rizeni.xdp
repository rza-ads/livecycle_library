if (xfa.event.newText.match(/[^0-9\/]/)) {
	xfa.event.change = "";
}
</script>
                              </event>
                              <event activity="exit" name="event__exit">
                                 <script contentType="application/x-javascript">
if (! validateRCLib.validateRC(this.rawValue)) {
