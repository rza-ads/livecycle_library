               <subform y="12mm" w="190mm" layout="tb" name="podpisy">
                  <bind match="dataRef" ref="$.podpisy"/>
                  <subform usehref="..\..\Fragments\podpis.xdp#som($template.podpis.podpis)" name="podpis1">
                     <keep intact="contentArea"/>
                     <bind match="dataRef" ref="$.podpis[0]"/>
                     <calculate>
                        <script contentType="application/x-javascript" runAt="client">
var spolecny = false, found = false, je_zastupce = false;
var osoba_podpis = null;

// pokud je v sekci IV. vybrana volba Ano
if (osoby_jednajici_za_dluznika.wrapper.osoby_switch.osoby_switch.rawValue == "1" ) {
	for (var i = 0; i &lt; osoby_jednajici_za_dluznika.wrapper.osoby._osoba.count; i++) {
		var item = osoby_jednajici_za_dluznika.wrapper.resolveNode("osoby.osoba[" + i + "]");
		
		// hleda se FO jednajici za dluznika, ktera je zastupcem pro cele rizeni
		if (item.osoba_header.druh_osoby.druh.rawValue == 1 &amp;&amp; item.osoba_header.osoba_je.rawValue == "2") {
			osoba_podpis = item.resolveNode("fyzicka_osoba[0]");
			found = osoba_podpis?true:false;
			break;
		}
		
		je_zastupce = true;
	}
	
	if (found == false) {
		for (var i = 0; i &lt; osoby_jednajici_za_dluznika.wrapper.osoby._osoba.count; i++) {
			var item = osoby_jednajici_za_dluznika.wrapper.resolveNode("osoby.osoba[" + i + "]");
			
			// hleda se FO, ktera pouze podava navrh
			if (item.osoba_header.druh_osoby.druh.rawValue == 1 &amp;&amp; item.osoba_header.osoba_je.rawValue == "1") {			
				osoba_podpis = item.resolveNode("fyzicka_osoba[0]");			
				found = osoba_podpis?true:false;
				break;
			}
			
			je_zastupce = true;
		}
	}
}

if (found == false &amp;&amp; je_zastupce == false) {
	if (dluznik.wrapper._fyzicka_osoba.count &gt; 0) {
		osoba_podpis = dluznik.wrapper.resolveNode("fyzicka_osoba[0]");
		found = osoba_podpis?true:false;
		
		if (dluznik.wrapper._fyzicka_osoba.count == 2)
			spolecny = true;
	}
}

//if(podpis_udaje.podepisujici.osoba.titul_pred.calculate.override != "disabled"){
if(podpis_udaje.podepisujici.osoba.localOverrideLib.get() != "false"){
	podpis_udaje.podepisujici.osoba.titul_pred.rawValue = found ? osoba_podpis.udaje_osoba_wrapper.udaje_osoba.osoba.titul_pred.rawValue : "";
};
//if(podpis_udaje.podepisujici.osoba.jmeno.calculate.override != "disabled"){
if(podpis_udaje.podepisujici.osoba.localOverrideLib.get() != "false"){
	podpis_udaje.podepisujici.osoba.jmeno.rawValue = found ? osoba_podpis.udaje_osoba_wrapper.udaje_osoba.osoba.jmeno.rawValue : "";
};
//if(podpis_udaje.podepisujici.osoba.prijmeni.calculate.override != "disabled"){
if(podpis_udaje.podepisujici.osoba.localOverrideLib.get() != "false"){
	podpis_udaje.podepisujici.osoba.prijmeni.rawValue = found ? osoba_podpis.udaje_osoba_wrapper.udaje_osoba.osoba.prijmeni.rawValue : "";
};
//if(podpis_udaje.podepisujici.osoba.titul_za.calculate.override != "disabled"){
if(podpis_udaje.podepisujici.osoba.localOverrideLib.get() != "false"){
	podpis_udaje.podepisujici.osoba.titul_za.rawValue = found ? osoba_podpis.udaje_osoba_wrapper.udaje_osoba.osoba.titul_za.rawValue : "";
};

if (spolecny == true) {
	sharedLib.visibleIfHidden(podpis2);
} else {
	sharedLib.hideIfVisible(podpis2);
	sharedLib.EraseAllChildFields(podpis2);
}
</script>
                     </calculate>
                     <event activity="initialize" ref="$" name="event__initialize">
                        <script contentType="application/x-javascript">
var spolecny = false, found = false, je_zastupce = false, found_po = false;
var osoba_podpis = null;

// pokud je v sekci IV. vybrana volba Ano
if (osoby_jednajici_za_dluznika.wrapper.osoby_switch.osoby_switch.rawValue == "1" ) {
	for (var i = 0; i &lt; osoby_jednajici_za_dluznika.wrapper.osoby._osoba.count; i++) {
		var item = osoby_jednajici_za_dluznika.wrapper.resolveNode("osoby.osoba[" + i + "]");
		
		// hleda se FO jednajici za dluznika, ktera je zastupcem pro cele rizeni
		if (item.osoba_header.druh_osoby.druh.rawValue == 1 &amp;&amp; item.osoba_header.osoba_je.rawValue == "2") {
			osoba_podpis = item.resolveNode("fyzicka_osoba[0]");
			found = osoba_podpis?true:false;
			break;
		}
		
		je_zastupce = true;
		
		if (item.osoba_header.druh_osoby.druh.rawValue == 2 &amp;&amp; item.osoba_header.osoba_je.rawValue == "2") {
			found_po =  item.resolveNode("pravnicka_osoba[0]")?true:false;
			break;
		}
		
	}                                                        
	
	if (found == false &amp;&amp; found_po == false) {
		for (var i = 0; i &lt; osoby_jednajici_za_dluznika.wrapper.osoby._osoba.count; i++) {
			var item = osoby_jednajici_za_dluznika.wrapper.resolveNode("osoby.osoba[" + i + "]");
			
			// hleda se FO, ktera pouze podava navrh
			if (item.osoba_header.druh_osoby.druh.rawValue == 1 &amp;&amp; item.osoba_header.osoba_je.rawValue == "1") {			
				osoba_podpis = item.resolveNode("fyzicka_osoba[0]");			
				found = osoba_podpis?true:false;
                break;
			}
			
			je_zastupce = true;
			
			if (item.osoba_header.druh_osoby.druh.rawValue == 2 &amp;&amp; item.osoba_header.osoba_je.rawValue == "1") {			
				found_po =  item.resolveNode("pravnicka_osoba[0]")?true:false;
				break;
			}
			
		}
	}
}

if (found == false &amp;&amp; je_zastupce == false) {
	if (dluznik.wrapper._fyzicka_osoba.count &gt; 0) {
		osoba_podpis = dluznik.wrapper.resolveNode("fyzicka_osoba[0]");
		found = osoba_podpis?true:false;
       
		if (dluznik.wrapper._fyzicka_osoba.count == 2)
			spolecny = true;
	}
	if (dluznik.wrapper._pravnicka_osoba.count &gt; 0) {
		found_po = true;
		
	}
}

if ( (
        (found &amp;&amp; localLib.podpisConcatenate(podpis_udaje.podepisujici.osoba) != localLib.podpisConcatenate(osoba_podpis.udaje_osoba_wrapper.udaje_osoba.osoba) ) ||
         found_po ||
        (! found_po &amp;&amp; ! found &amp;&amp; je_zastupce )) ) {
			podpis_udaje.podepisujici.osoba.localOverrideLib.set();		
		}
/*
if ( (
        (found &amp;&amp; podpis_udaje.podepisujici.osoba.jmeno.rawValue != osoba_podpis.udaje_osoba_wrapper.udaje_osoba.osoba.jmeno.rawValue) ||
        found_po ||
        (! found_po &amp;&amp; ! found &amp;&amp; je_zastupce ))  &amp;&amp; 
    	podpis_udaje.podepisujici.osoba.jmeno.rawValue != "" &amp;&amp; podpis_udaje.podepisujici.osoba.jmeno.rawValue != null )
    			podpis_udaje.podepisujici.osoba.jmeno.calculate.override = "disabled";

if ( (
        (found &amp;&amp; podpis_udaje.podepisujici.osoba.prijmeni.rawValue != osoba_podpis.udaje_osoba_wrapper.udaje_osoba.osoba.prijmeni.rawValue) ||
        found_po ||
        (! found_po &amp;&amp; ! found &amp;&amp; je_zastupce )) &amp;&amp; 
    	podpis_udaje.podepisujici.osoba.prijmeni.rawValue != "" &amp;&amp; podpis_udaje.podepisujici.osoba.prijmeni.rawValue != null )
    			podpis_udaje.podepisujici.osoba.prijmeni.calculate.override = "disabled";

if ( (
        (found &amp;&amp; podpis_udaje.podepisujici.osoba.titul_za.rawValue != osoba_podpis.udaje_osoba_wrapper.udaje_osoba.osoba.titul_za.rawValue) ||
        found_po ||
        (! found_po &amp;&amp; ! found &amp;&amp; je_zastupce )) &amp;&amp; 
    	podpis_udaje.podepisujici.osoba.titul_za.rawValue != "" &amp;&amp; podpis_udaje.podepisujici.osoba.titul_za.rawValue != null )
    			podpis_udaje.podepisujici.osoba.titul_za.calculate.override = "disabled";
*/
</script>
                     </event>
                     <?templateDesigner expand 0?>
