               <subform w="190mm" layout="tb" name="forma_upadku">
                  <field name="forma_upadku" w="190mm" h="6mm" hAlign="right">
                     <ui>
                        <choiceList>
                           <border>
                              <edge thickness="0.1mm">
                                 <color value="180,180,180"/>
                              </edge>
                              <corner thickness="0.1mm">
                                 <color value="180,180,180"/>
                              </corner>
                           </border>
                        </choiceList>
                     </ui>
                     <font typeface="Myriad Pro">
                        <fill>
                           <color value="51,51,51"/>
                        </fill>
                     </font>
                     <margin topInset="1mm" bottomInset="0mm" leftInset="2mm" rightInset="2mm"/>
                     <para marginLeft="2.835pt" marginRight="2.835pt" vAlign="middle" spaceAbove="2pt"/>
                     <caption reserve="119mm">
                        <para vAlign="middle"/>
                        <value>
                           <text>Dlužník je v úpadku ve formě:</text>
                        </value>
                        <font typeface="Myriad Pro" size="9pt">
                           <fill>
                              <color value="51,51,51"/>
                           </fill>
                        </font>
                     </caption>
                     <bind match="dataRef" ref="$.forma_upadku"/>
                     <assist>
                        <speak priority="toolTip"/>
                     </assist>
                     <items>
                        <text>platební neschopnosti</text>
                        <text>předlužení</text>
                     </items>
                     <items save="1" presence="hidden">
                        <text>1</text>
                        <text>2</text>
                     </items>
                     <event activity="change" name="event__change">
                        <script contentType="application/x-javascript">
var newValue = this.boundItem(xfa.event.fullText);

if (newValue == 2) {
	sharedLib.visibleIfHidden(celkem);
	localLib.dalsi_skutecnosti_init(
		newValue, 
		druh_navrhu.wrapper.spojeni_ano.rozhodnuti_o_upadku.rawValue, 
		druh_navrhu.wrapper.spojeni.spojeni.rawValue
	);
	dalsi_skutecnosti.dalsi_skutecnosti.rawValue = null;
} else {
	sharedLib.hideIfVisible(celkem);
 	sharedLib.EraseAllChildFields(celkem);
	localLib.dalsi_skutecnosti_init(
		newValue, 
		druh_navrhu.wrapper.spojeni_ano.rozhodnuti_o_upadku.rawValue, 
		druh_navrhu.wrapper.spojeni.spojeni.rawValue
	);
	//sharedLib.hideIfVisible(dalsi_skutecnosti.popis);
	//dalsi_skutecnosti.popis.rawValue = null;
};

labels.sec5_popis_caption(
	dalsi_skutecnosti.dalsi_skutecnosti.rawValue,
	druh_navrhu.wrapper.spojeni_ano.rozhodnuti_o_upadku.rawValue,
	Formular.dluznik,
	druh_navrhu.wrapper.spojeni.spojeni.rawValue,
	newValue ,
	dalsi_skutecnosti.popis);
</script>
                     </event>
                     <event activity="initialize" name="event__initialize">
                        <script contentType="application/x-javascript">	if (localLib.dluznikPodnikatel(dluznik)) {
		sharedLib.openIfReadOnly(this);	
	} else {
		if ( dluznik.wrapper.druh_osoby.druh.rawValue != null) {
			//sharedLib.setOnValueChange(this, "1");
			sharedLib.readOnlyIfOpen(this);	
		};
	}
	
if (this.rawValue == "2") {
	sharedLib.visibleIfHidden(celkem);
	dalsi_skutecnosti.dalsi_skutecnosti.execInitialize()
	//sharedLib.visibleIfHidden(dalsi_skutecnosti.popis);
} else {
	sharedLib.hideIfVisible(celkem);
	dalsi_skutecnosti.dalsi_skutecnosti.execInitialize() ;
	//sharedLib.hideIfVisible(dalsi_skutecnosti.popis);	
}
</script>
                     </event>
                     <traversal>
                        <traverse ref="calc_forma_upadku[0]"/>
                     </traversal>
                  </field>
                  <field name="calc_forma_upadku" w="10mm" h="8mm" access="readOnly" presence="hidden">
                     <ui>
                        <textEdit>
                           <border>
                              <edge stroke="lowered"/>
                           </border>
                           <margin/>
                        </textEdit>
                     </ui>
                     <font typeface="Myriad Pro"/>
                     <margin topInset="1mm" bottomInset="1mm" leftInset="1mm" rightInset="1mm"/>
                     <para vAlign="middle"/>
                     <bind match="none"/>
                     <calculate>
                        <script contentType="application/x-javascript">
/*jde jen o to, aby se pri zadani ICO do FO dluznika prepocetla forma upadku*/

for (var i = 0; i &lt; dluznik.wrapper._fyzicka_osoba.count; i++) {
	xObj = xfa.resolveNode("dluznik.wrapper.fyzicka_osoba["+i+"].udaje_osoba_wrapper.udaje_osoba.ico");
//	xfa.host.messageBox("dluznik.wrapper.fyzicka_osoba["+i+"].udaje_osoba_wrapper.udaje_osoba.ico");
};

if (! localLib.dluznikPodnikatel(dluznik) ) sharedLib.setOnValueChange(popis_rozhodujicich_skutecnosti.wrapper.forma_upadku.forma_upadku, "1");

labels.sec5_popis_caption(
	dalsi_skutecnosti.dalsi_skutecnosti.rawValue,
	druh_navrhu.wrapper.spojeni_ano.rozhodnuti_o_upadku.rawValue,
	Formular.dluznik,
	druh_navrhu.wrapper.spojeni.spojeni.rawValue,
	forma_upadku.rawValue,
	dalsi_skutecnosti.popis);

forma_upadku.execInitialize();
</script>
                     </calculate>
