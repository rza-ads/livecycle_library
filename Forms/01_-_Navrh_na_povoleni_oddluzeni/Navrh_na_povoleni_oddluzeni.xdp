                        </items>
                        <bind match="none"/>
                        <assist>
                           <toolTip>Uveďte, zda existuje osoba oprávněná jednat za dlužníka. Následně specifikujte, zda se jedná o zástupce dlužníka pro insolvenční řízení, nebo osobu oprávněnou za dlužníka sepsat a podat návrh na povolení oddlužení.</toolTip>
                           <speak priority="toolTip"/>
