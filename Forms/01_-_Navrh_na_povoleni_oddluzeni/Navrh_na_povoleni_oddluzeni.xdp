                                 <script contentType="application/x-javascript">
var rowNumber = this.parent.parent.index;

_zavazek.insertInstance(rowNumber + 1);
xfa.form.recalculate(1);
</script>
                              </event>
                              <assist>
                                 <toolTip>Přidá věřitele.</toolTip>
                                 <speak priority="toolTip"/>
                              </assist>
                              <traversal>
