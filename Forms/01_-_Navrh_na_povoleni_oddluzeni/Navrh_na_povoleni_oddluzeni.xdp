                     <event activity="change" name="event__change">
                        <script contentType="application/x-javascript">
// nastaveni labelu
labels.setFormTitle(this.rawValue, Formular);

// spojeni ano
if (this.rawValue == '1') {
	sharedLib.visibleIfHidden(popis_rozhodujicich_skutecnosti);
	
	sharedLib.visibleIfHidden(spojeni_ano);
	sharedLib.hideIfVisible(spojeni_ne);
	spojeni_ano.rozhodnuti_o_upadku.rawValue = "1";
	spojeni_ano.rozhodnuti_o_upadku.execEvent("initialize");
}
// spojeni ne
else if (this.rawValue == '0') {
	sharedLib.EraseAllChildFields(popis_rozhodujicich_skutecnosti);
	sharedLib.hideIfVisible(popis_rozhodujicich_skutecnosti);
	
	sharedLib.hideIfVisible(spojeni_ano);
	sharedLib.visibleIfHidden(spojeni_ne);	
	spojeni_ano.rozhodnuti_o_upadku.rawValue = null;
	spojeni_ano.rozhodnuti_o_upadku.execEvent("initialize");
}
// spojeni nevyplneno
else {
	sharedLib.hideIfVisible(popis_rozhodujicich_skutecnosti);
	
	sharedLib.hideIfVisible(spojeni_ano);
	sharedLib.hideIfVisible(spojeni_ne);
	spojeni_ano.rozhodnuti_o_upadku.rawValue = null;
	spojeni_ano.rozhodnuti_o_upadku.execEvent("initialize");
}
</script>
                     </event>
                     <bind match="dataRef" ref="$.spojeni"/>
                     <event activity="initialize" name="event__initialize">
                        <script contentType="application/x-javascript">
// nastaveni labelu
labels.setFormTitle(this.rawValue, Formular);

// spojeni ano
if (this.rawValue == '1') {
	sharedLib.visibleIfHidden(spojeni_ano);
	sharedLib.hideIfVisible(spojeni_ne);
} 
// spojeni ne
else if (this.rawValue == '0') {
	sharedLib.hideIfVisible(spojeni_ano);
	sharedLib.visibleIfHidden(spojeni_ne);
}
// spojeni nevyplneno
else {
	sharedLib.hideIfVisible(spojeni_ano);
	sharedLib.hideIfVisible(spojeni_ne);
}
</script>
                     </event>
                     <assist>
                        <toolTip>Zaškrtněte v případě, spojuje-li dlužník návrh na povolení oddlužení s insolvenčním návrhem.</toolTip>
