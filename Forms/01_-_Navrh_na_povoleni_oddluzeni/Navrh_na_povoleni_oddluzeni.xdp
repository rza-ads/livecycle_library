                     <field h="7mm" name="ano" w="14mm">
                        <ui>
                           <checkButton size="3.8806mm" shape="round">
                              <border>
                                 <edge thickness="0.2mm">
                                    <color value="130,130,130"/>
                                 </edge>
                                 <fill/>
                                 <corner thickness="0.2mm">
                                    <color value="130,130,130"/>
                                 </corner>
                              </border>
                           </checkButton>
                        </ui>
                        <font typeface="Myriad Pro">
                           <fill>
                              <color value="251,85,91"/>
                           </fill>
                        </font>
                        <margin leftInset="1mm" rightInset="1mm"/>
                        <para vAlign="middle"/>
                        <caption placement="right" reserve="6.3129mm">
                           <para vAlign="middle" spaceAbove="1pt"/>
                           <font typeface="Myriad Pro">
                              <fill>
                                 <color value="51,51,51"/>
                              </fill>
                           </font>
                           <value>
                              <text>Ano</text>
                           </value>
                        </caption>
                        <items>
                           <text>1</text>
                        </items>
                        <bind match="none"/>
                        <assist>
                           <toolTip>Zaškrtněte v případě, že je návrh na povolení oddlužení podáván jako společný návrh manželů na povolení oddlužení. V případě společného návrhu manželů na povolení oddlužení se manželé považují za jednoho dlužníka.</toolTip>
                           <speak priority="toolTip"/>
                        </assist>
                     </field>
                     <field w="13mm" h="7mm" name="ne">
                        <ui>
                           <checkButton size="3.8806mm" shape="round">
                              <border>
                                 <edge thickness="0.2mm">
                                    <color value="130,130,130"/>
                                 </edge>
                                 <fill/>
                                 <corner thickness="0.2mm">
                                    <color value="130,130,130"/>
                                 </corner>
                              </border>
                           </checkButton>
                        </ui>
                        <font typeface="Myriad Pro">
                           <fill>
                              <color value="251,85,91"/>
                           </fill>
                        </font>
                        <margin leftInset="1mm" rightInset="1mm"/>
                        <para vAlign="middle"/>
                        <caption placement="right" reserve="4.776mm">
                           <para vAlign="middle" spaceAbove="1pt"/>
                           <value>
                              <text>Ne</text>
                           </value>
                           <font typeface="Myriad Pro">
                              <fill>
                                 <color value="51,51,51"/>
                              </fill>
                           </font>
                        </caption>
                        <items>
                           <text>0</text>
                        </items>
                        <bind match="none"/>
                        <assist>
                           <toolTip>Zaškrtněte v případě, že dlužník podává návrh na povolení oddlužení sám.</toolTip>
                           <speak priority="toolTip"/>
                        </assist>
                     </field>
                     <bind match="dataRef" ref="$.spolecny_navrh"/>
                     <event activity="change" name="event__change">
                        <script contentType="application/x-javascript">
labels.setFromSpolecnyNavrh(this.rawValue, Formular);
//okolnosti_pro_vysi_plneni_header.partner_wrapper.partner.execEvent('change');


if (this.rawValue == '1') {

	dluznik.wrapper._fyzicka_osoba
	
	prijmy_ocekavane.wrapper.prijmy_ocekavane._dluznik.addInstance(1);
	
	schopnosti.wrapper._dluznik.addInstance(1);
	
	sharedLib.visibleIfHidden(xfa.resolveNode("schopnosti.wrapper.dluznik[0]").label);
	sharedLib.setOnValueChange(xfa.resolveNode("schopnosti.wrapper.dluznik[1]").label, labels.texts.dluznik2);
	
	sharedLib.hideIfVisible(insolvence_proti_partnerovi_wraper);
	sharedLib.EraseAllChildFields(insolvence_proti_partnerovi_wraper);
	insolvence_proti_partnerovi_wraper.spisova_znacka_wrapper.spisova_znacka.rejstrik.execCalculate(); /*doplni INS - jinak dela problem pri podpisu*/

	if (dluznik.wrapper.druh_osoby.druh.rawValue != 1) {
		dluznik.wrapper.druh_osoby.druh.rawValue = 1;
		sharedLib.setOnValueChange(popis_rozhodujicich_skutecnosti.wrapper.forma_upadku.forma_upadku, "1");	
	};
	if (dluznik.wrapper.druh_osoby.druh.access != 'readOnly') dluznik.wrapper.druh_osoby.druh.access = 'readOnly';

	dluznik.wrapper._pravnicka_osoba.setInstances(0);
	if (dluznik.wrapper._fyzicka_osoba.count == 0) 
		dluznik.wrapper._fyzicka_osoba.addInstance(1);	
	dluznik.wrapper._fyzicka_osoba.addInstance(1);
		
	sharedLib.visibleIfHidden(xfa.resolveNode("okolnosti_pro_vysi_plneni.wrapper.vyz_povinnosti.dluznik2[0]").label);
	sharedLib.setOnValueChange(xfa.resolveNode("okolnosti_pro_vysi_plneni.wrapper.vyz_povinnosti.dluznik2[0]").label, labels.texts.dluznik1);
	
	xfa.resolveNode("okolnosti_pro_vysi_plneni.wrapper.vyz_povinnosti")._dluznik2.addInstance(1);
	sharedLib.visibleIfHidden(xfa.resolveNode("okolnosti_pro_vysi_plneni.wrapper.vyz_povinnosti.dluznik2[1]").label);
	sharedLib.setOnValueChange(xfa.resolveNode("okolnosti_pro_vysi_plneni.wrapper.vyz_povinnosti.dluznik2[1]").label, labels.texts.dluznik2);
	
	if (dluznik.wrapper._fyzicka_osoba.count == 2) {
		sharedLib.setOnValueChange(dluznik.wrapper.resolveNode("fyzicka_osoba[0]").udaje_osoba_wrapper.label_wrapper.label_name, labels.texts.dluznik1);
		sharedLib.visibleIfHidden(dluznik.wrapper.resolveNode("fyzicka_osoba[0]").udaje_osoba_wrapper.label_wrapper.label_name);		
		sharedLib.setOnValueChange(dluznik.wrapper.resolveNode("fyzicka_osoba[1]").udaje_osoba_wrapper.label_wrapper.label_name, labels.texts.dluznik2);
		sharedLib.visibleIfHidden(dluznik.wrapper.resolveNode("fyzicka_osoba[1]").udaje_osoba_wrapper.label_wrapper.label_name);
	}
}
else {
	prijmy_ocekavane.wrapper.prijmy_ocekavane._dluznik.setInstances(1);

	schopnosti.wrapper._dluznik.setInstances(1);
	sharedLib.hideIfVisible(xfa.resolveNode("schopnosti.wrapper.dluznik[0]").label);
	
	
	xfa.resolveNode("okolnosti_pro_vysi_plneni.wrapper.vyz_povinnosti")._dluznik2.setInstances(1);
	sharedLib.setOnValueChange(xfa.resolveNode("okolnosti_pro_vysi_plneni.wrapper.vyz_povinnosti.dluznik2[0]").label, "");
	
	
	sharedLib.visibleIfHidden(insolvence_proti_partnerovi_wraper);
	
	dluznik.wrapper.druh_osoby.druh.access = 'open';
	dluznik.wrapper.druh_osoby.druh.rawValue = null;
	dluznik.wrapper._fyzicka_osoba.setInstances(0);
	
	sharedLib.hideIfVisible(okolnosti_pro_vysi_plneni.wrapper.vyz_povinnosti.dluznik2[0].label);
	okolnosti_pro_vysi_plneni.wrapper.vyz_povinnosti._dluznik2.setInstances([1]);
	
	if (dluznik.wrapper._fyzicka_osoba.count == 2) {
		//sharedLib.setOnValueChange(dluznik.wrapper.fyzicka_osoba[0].udaje_osoba_wrapper.label_wrapper.label_name, labels.texts.dluznik1);
		sharedLib.hideIfVisible(dluznik.wrapper.resolveNode("fyzicka_osoba[0]").udaje_osoba_wrapper.label_wrapper.label_name);		
		//sharedLib.setOnValueChange(dluznik.wrapper.fyzicka_osoba[1].udaje_osoba_wrapper.label_wrapper.label_name, labels.texts.dluznik2);
		sharedLib.hideIfVisible(dluznik.wrapper.resolveNode("fyzicka_osoba[1]").udaje_osoba_wrapper.label_wrapper.label_name);
	}
	
	if (localLib.dluznikPodnikatel(dluznik)) {
		sharedLib.visibleIfHidden(Formular.popis_rozhodujicich_skutecnosti.wrapper.forma_upadku);
	} else {
		sharedLib.hideIfVisible(Formular.popis_rozhodujicich_skutecnosti.wrapper.forma_upadku);
		sharedLib.EraseAllChildFields(Formular.popis_rozhodujicich_skutecnosti.wrapper.forma_upadku);
		sharedLib.hideIfVisible(Formular.popis_rozhodujicich_skutecnosti.wrapper.dalsi_skutecnosti.dalsi_skutecnosti);
		sharedLib.EraseAllChildFields(Formular.popis_rozhodujicich_skutecnosti.wrapper.dalsi_skutecnosti.dalsi_skutecnosti);
	}
}
</script>
                     </event>
                     <event activity="initialize" name="event__initialize">
                        <script contentType="application/x-javascript">
// nastaveni labelu
labels.setFromSpolecnyNavrh(this.rawValue, Formular);

if (this.rawValue == '1') {
	sharedLib.hideIfVisible(insolvence_proti_partnerovi_wraper);
	
	sharedLib.visibleIfHidden(xfa.resolveNode("schopnosti.wrapper.dluznik[0]").label);
	sharedLib.setOnValueChange(xfa.resolveNode("schopnosti.wrapper.dluznik[1]").label, labels.texts.dluznik2);
	dluznik.wrapper.druh_osoby.druh.access = 'readOnly';
	
	if (dluznik.wrapper._fyzicka_osoba.count == 2) {
		sharedLib.setOnValueChange(dluznik.wrapper.resolveNode("fyzicka_osoba[0]").udaje_osoba_wrapper.label_wrapper.label_name, labels.texts.dluznik1);
		sharedLib.visibleIfHidden(dluznik.wrapper.resolveNode("fyzicka_osoba[0]").udaje_osoba_wrapper.label_wrapper.label_name);		
		sharedLib.setOnValueChange(dluznik.wrapper.resolveNode("fyzicka_osoba[1]").udaje_osoba_wrapper.label_wrapper.label_name, labels.texts.dluznik2);
		sharedLib.visibleIfHidden(dluznik.wrapper.resolveNode("fyzicka_osoba[1]").udaje_osoba_wrapper.label_wrapper.label_name);
		sharedLib.setOnValueChange(okolnosti_pro_vysi_plneni.wrapper.vyz_povinnosti.dluznik2[0].label, labels.texts.dluznik1);
		sharedLib.setOnValueChange(okolnosti_pro_vysi_plneni.wrapper.vyz_povinnosti.dluznik2[1].label, labels.texts.dluznik2);
	}
}
else {
	sharedLib.hideIfVisible(xfa.resolveNode("schopnosti.wrapper.dluznik[0]").label);
	sharedLib.setOnValueChange(xfa.resolveNode("okolnosti_pro_vysi_plneni.wrapper.vyz_povinnosti.dluznik2[0]").label, "";

	sharedLib.visibleIfHidden(insolvence_proti_partnerovi_wraper);
	
	dluznik.wrapper.druh_osoby.druh.access = 'open';
	
	if (dluznik.wrapper._fyzicka_osoba.count == 2) {
		//sharedLib.setOnValueChange(dluznik.wrapper.fyzicka_osoba[0].udaje_osoba_wrapper.label_wrapper.label_name, labels.texts.dluznik1);
		sharedLib.hideIfVisible(dluznik.wrapper.resolveNode("fyzicka_osoba[0]").udaje_osoba_wrapper.label_wrapper.label_name);		
		//sharedLib.setOnValueChange(dluznik.wrapper.fyzicka_osoba[1].udaje_osoba_wrapper.label_wrapper.label_name, labels.texts.dluznik2);
		sharedLib.hideIfVisible(dluznik.wrapper.resolveNode("fyzicka_osoba[1]").udaje_osoba_wrapper.label_wrapper.label_name);
	}
	
	if (localLib.dluznikPodnikatel(dluznik)) {
		sharedLib.visibleIfHidden(Formular.popis_rozhodujicich_skutecnosti.wrapper.forma_upadku);
	} else {
		sharedLib.hideIfVisible(Formular.popis_rozhodujicich_skutecnosti.wrapper.forma_upadku);
	}
}
</script>
