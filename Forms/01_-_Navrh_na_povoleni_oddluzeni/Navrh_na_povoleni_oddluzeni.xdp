                              <speak priority="toolTip"/>
                              <toolTip>Dlužník připojuje závazný příslib, že měsíční splátku bude zcela nebo zčásti hradit ze své nezabavitelné částky:</toolTip>
                           </assist>
                           <bind match="dataRef" ref="$.switch"/>
                           <event activity="change" name="event__change">
                              <script contentType="application/x-javascript">
nazev = "Závazný příslib dlužníka, že měsíční splátku bude zcela nebo zčásti hradit i ze svého životního minima";

if (this.rawValue != "1") {
	sharedLib.hideIfVisible(vyjadreni);
	sharedLib.EraseAllChildFields(vyjadreni);
	
	attObj = localLib.findAttachement (nazev);
	if (attObj != null) {
		attObj.parent._priloha.removeInstance(attObj.index)
	}
}
else {
	sharedLib.visibleIfHidden(vyjadreni);
	
	if (localLib.findAttachement (nazev) == null) {
		
		obj_priloha = seznam_priloh.wrapper.listinne_prilohy_wrapper.listinne_prilohy._priloha.addInstance(0);
		obj_priloha.nazev.rawValue = nazev ;
	};
};
</script>
                           </event>
                           <event activity="initialize" name="event__initialize">
                              <script contentType="application/x-javascript">

if (this.rawValue != "1") {
	sharedLib.hideIfVisible(vyjadreni);
	}
else {
	sharedLib.visibleIfHidden(vyjadreni);
};
</script>
                           </event>
                           <?templateDesigner expand 0?>
