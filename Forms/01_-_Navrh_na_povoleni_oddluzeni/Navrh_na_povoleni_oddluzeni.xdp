                     <event activity="change" name="event__change">
                        <script contentType="application/x-javascript">
var newValue = this.boundItem(xfa.event.fullText);

if (newValue == 2) {
	Formular.navrh_na_zmenu_splatky.wrapper.navrh.navrh.rawValue = "0";	
	Formular.navrh_na_zmenu_splatky.wrapper.navrh.navrh.execEvent("change");
	Formular.navrh_na_zmenu_splatky.wrapper.navrh.navrh.access = "readOnly";
} else {
	Formular.navrh_na_zmenu_splatky.wrapper.navrh.navrh.access = "open";
}
if (newValue == 1) {
	sharedLib.visibleIfHidden(prijmy_ocekavane.wrapper.prijmy_ocekavane.prislibDluznika);
} else {
	sharedLib.hideIfVisible(prijmy_ocekavane.wrapper.prijmy_ocekavane.prislibDluznika);
	sharedLib.EraseAllChildFields(prijmy_ocekavane.wrapper.prijmy_ocekavane.prislibDluznika);
}

</script>
