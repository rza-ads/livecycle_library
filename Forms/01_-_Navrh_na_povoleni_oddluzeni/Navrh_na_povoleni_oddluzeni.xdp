                        <script contentType="application/x-javascript">
// ano
if (this.rawValue == '1') {
	sharedLib.visibleIfHidden(drivejsi_rizeni_sekce)
} 
// ne
else {
	sharedLib.hideIfVisible(drivejsi_rizeni_sekce);
}
</script>
                     </event>
                     <event activity="change" name="event__change">
                        <script contentType="application/x-javascript">
// ano
if (this.rawValue == '1') {
	sharedLib.visibleIfHidden(drivejsi_rizeni_sekce);
	
	if (drivejsi_rizeni_sekce.drivejsi_rizeni.spisova_znacka.rejstrik.rawValue != "INS") 
		drivejsi_rizeni_sekce.drivejsi_rizeni.spisova_znacka.rejstrik.rawValue = "INS";
}

// ne
if (this.rawValue == '0') {
	drivejsi_rizeni_sekce._drivejsi_rizeni.setInstances(1);
	sharedLib.hideIfVisible(drivejsi_rizeni_sekce);
	sharedLib.EraseAllChildFields(drivejsi_rizeni_sekce);
}
</script>
