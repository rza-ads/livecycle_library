if (_z_veritel.count &lt;= 1) {
	xfa.host.messageBox("Tabulka musí mít minimálně jeden řádek. Řádek nelze odebrat.", "Řádek nelze odebrat", 3);
} else {
	_z_veritel.removeInstance(this.parent.parent.index);
	xfa.form.recalculate(1);
}
</script>
                              </event>
