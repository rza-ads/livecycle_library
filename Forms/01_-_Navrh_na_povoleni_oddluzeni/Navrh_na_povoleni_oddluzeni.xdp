                              <event activity="change" name="event__change">
                                 <script contentType="application/x-javascript">
var newValue = this.boundItem(xfa.event.fullText);


if (newValue == 2) {
	
	_prijmyZosvc.addInstance(1);
	_prijmyNotOsvc.setInstances(0);
} else {
	
	_prijmyNotOsvc.addInstance(1);
	_prijmyZosvc.setInstances(0);
}
</script>
