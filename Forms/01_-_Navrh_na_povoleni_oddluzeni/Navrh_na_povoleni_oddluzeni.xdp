                        </font>
                        <margin topInset="1mm" bottomInset="1mm" leftInset="2mm" rightInset="2mm"/>
                        <para marginLeft="2.835pt" marginRight="2.835pt" spaceAbove="1pt" spaceBelow="1pt"/>
                        <border>
                           <edge thickness="0.2mm" presence="hidden">
                              <color value="130,130,130"/>
                           </edge>
                           <corner thickness="0.2mm" presence="hidden">
                              <color value="130,130,130"/>
                           </corner>
                        </border>
                        <bind match="dataRef" ref="$.predchozi_zamestnani"/>
                        <assist>
                           <speak priority="toolTip"/>
                           <toolTip>Uveďte ta předchozí zaměstnání nebo podnikání, ve kterých dlužník působil delší dobu nebo získal určitou odbornost, dovednosti či specializaci; především uveďte obor, ve kterém dlužník získal nejdelší praxi, případně praxi, která odpovídá nejvyššímu dosaženému vzdělání dlužníka nebo ve které dlužník dosahoval nejvyššího výdělku. Stručně shrňte profesní životopis dlužníka, aby bylo patrné, jakou práci dlužník historicky vykonával nebo jakému oboru činnosti se věnoval. Tato informace je relevantní pro zjištění schopnosti vykonávat přiměřenou výdělečnou činnost a určit propočet předpokládaného uspokojení nezajištěných věřitelů.</toolTip>
                        </assist>
                        <traversal>
                           <traverse ref="dojizdeni[0]"/>
                        </traversal>
                        <caption placement="top" reserve="4mm">
                           <value>
                              <text>Nejvýznamnější předchozí zaměstnání nebo podnikání:</text>
                           </value>
                           <font typeface="Myriad Pro" size="9pt">
                              <fill>
                                 <color value="51,51,51"/>
                              </fill>
                           </font>
                           <para vAlign="middle"/>
                        </caption>
                     </field>
                     <field name="dojizdeni" minH="19mm" w="190mm">
                        <ui>
                           <textEdit multiLine="1">
                              <border>
                                 <edge thickness="0.1mm">
                                    <color value="180,180,180"/>
                                 </edge>
                                 <corner thickness="0.1mm">
                                    <color value="180,180,180"/>
                                 </corner>
                              </border>
                              <margin/>
                           </textEdit>
                        </ui>
