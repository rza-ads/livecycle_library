         <script contentType="application/x-javascript" name="labels">
var texts = 
{
	form_title				: "Návrh na povolení oddlužení", 
	form_title_ins			: "Insolvenční návrh spojený s návrhem na povolení oddlužení",
	
	dluznik1				: "Dlužník",
	dluznik2				: "Dlužnice",
	
	sec3					: "III. Identifikace dlužníka",
	sec3_multi				: "III. Identifikace dlužníků",
	
	sec4					: "IV. Identifikace osoby oprávněné jednat za dlužníka",
	sec4_multi				: "IV. Identifikace osoby oprávněné jednat za dlužníky",
	sec4_sublabel			: "Osoba oprávněná jednat za dlužníka je:",
	sec4_multi_sublabel		: "Osoba oprávněná jednat za dlužníky je:",
	
	sec5					: "V. Popis rozhodujících skutečností osvědčujících úpadek dlužníka",
	sec5_multi				: "V. Popis rozhodujících skutečností osvědčujících úpadek dlužníků",
	sec5_2					: "V. Popis rozhodujících skutečností osvědčujících hrozící úpadek dlužníka",
	sec5_multi_2			: "V. Popis rozhodujících skutečností osvědčujících hrozící úpadek dlužníků",
	sec5_sublabel			: "Závazky osvědčující úpadek:",
	sec5_sublabel_2			: "Závazky osvědčující hrozící úpadek:",
	sec5_popis_caption		: "Skutečnosti osvědčující úpadek:",
	sec5_popis_caption_2	: "Skutečnosti osvědčující hrozící úpadek:",
	sec5_popis_caption_3	: "Případné doplňující údaje:",
	
	sec6					: "VI. Podrobný popis okolností, z nichž lze usuzovat na výši hodnoty plnění, které při oddlužení obdrží nezajištění věřitelé dlužníka včetně odůvodnění schopnosti splnit podmínku podle § 395 odst. 1 písm. b) InsZ",
	sec6_multi				: "VI. Podrobný popis okolností, z nichž lze usuzovat na výši hodnoty plnění, které při oddlužení obdrží nezajištění věřitelé dlužníků včetně odůvodnění schopnosti splnit podmínku podle § 395 odst. 1 písm. b) InsZ",
	
	sec7					: "VII. Údaje o všech příjmech dlužníka za posledních 12 měsíců",
	sec7_multi				: "VII. Údaje o všech příjmech dlužníků za posledních 12 měsíců",
	
	sec8					: "VIII. Očekávané příjmy dlužníka",
	sec8_multi				: "VIII. Očekávané příjmy dlužníků",
	
	sec8_prijmyZ			: "Dlužník má příjem ze:",
	sec8_prijmyZ_multi		: "Dlužnice má příjem ze:",
	
	sec9					: "X. Dřívější insolvenční řízení dlužníka",
	sec9_multi				: "X. Dřívější insolvenční řízení dlužníků",
	sec9_sublabel			: "Dřívější insolvenční řízení dlužníka:",
	sec9_multi_sublabel		: "Dřívější insolvenční řízení dlužníků:",
	
	sec10_duvody_upadku_caption			: "Důvody, které vedly dlužníka k úpadku:",
	sec10_multi_duvody_upadku_caption	: "Důvody, které vedly dlužníky k úpadku:",
	
	sec11_sublabel			: "Dlužník má věřitele se sídlem, bydlištěm nebo obvyklým místem pobytu v jiném členském státě Evropské unie:",
	sec11_multi_sublabel	: "Dlužníci mají věřitele se sídlem, bydlištěm nebo obvyklým místem pobytu v jiném členském státě Evropské unie:",
};

function setFormTitle(ins_navrh, formObj) {
	if (formObj == null)
		return;
		
	sharedLib.setOnValueChange(formObj.title.title, ins_navrh == "1" ? texts.form_title_ins : texts.form_title);
}

function setFromUpadek(upadek, dalsi_skut, formObj) {
	if (formObj == null)
		return;		
		
	if (upadek == "2") {		
		sharedLib.setOnValueChange(formObj.popis_rozhodujicich_skutecnosti.wrapper.label, formObj.druh_navrhu.wrapper.spolecny_navrh.spolecny_navrh.rawValue == "1" ? texts.sec5_multi_2 : texts.sec5_2);
		sharedLib.setOnValueChange(formObj.popis_rozhodujicich_skutecnosti.wrapper.zavazky.label, texts.sec5_sublabel_2);
		
	} else {		
		sharedLib.setOnValueChange(formObj.popis_rozhodujicich_skutecnosti.wrapper.label, formObj.druh_navrhu.wrapper.spolecny_navrh.spolecny_navrh.rawValue == "1" ? texts.sec5_multi : texts.sec5);
		sharedLib.setOnValueChange(formObj.popis_rozhodujicich_skutecnosti.wrapper.zavazky.label, texts.sec5_sublabel);
	}
	labels.sec5_popis_caption(
		Formular.popis_rozhodujicich_skutecnosti.wrapper.dalsi_skutecnosti.dalsi_skutecnosti.rawValue,
		Formular.druh_navrhu.wrapper.spojeni_ano.rozhodnuti_o_upadku.rawValue,
		Formular.dluznik,
		Formular.druh_navrhu.wrapper.spojeni.spojeni.rawValue,
		Formular.popis_rozhodujicich_skutecnosti.wrapper.forma_upadku.forma_upadku.rawValue,
		Formular.popis_rozhodujicich_skutecnosti.wrapper.dalsi_skutecnosti.popis);
}

function setFromSpolecnyNavrh(spolecny_navrh, formObj) {
	if (formObj == null)
		return;		
		
	if (spolecny_navrh == "1") {		
		sharedLib.setOnValueChange(formObj.dluznik.wrapper.label, texts.sec3_multi);
		sharedLib.setOnValueChange(formObj.osoby_jednajici_za_dluznika.wrapper.label, texts.sec4_multi);
		sharedLib.setOnValueChange(formObj.osoby_jednajici_za_dluznika.wrapper.osoby_switch.text, texts.sec4_multi_sublabel);
		
		if (formObj.druh_navrhu.wrapper.spojeni_ano.rozhodnuti_o_upadku != null &amp;&amp; formObj.druh_navrhu.wrapper.spojeni_ano.rozhodnuti_o_upadku.rawValue == "2")
			sharedLib.setOnValueChange(formObj.popis_rozhodujicich_skutecnosti.wrapper.label, texts.sec5_multi_2);
		else
			sharedLib.setOnValueChange(formObj.popis_rozhodujicich_skutecnosti.wrapper.label, texts.sec5_multi);
			
		sharedLib.setOnValueChange(formObj.okolnosti_pro_vysi_plneni.wrapper.label, texts.sec6_multi);
		sharedLib.setOnValueChange(formObj.prijmy.wrapper.label, texts.sec7_multi);
		sharedLib.setOnValueChange(formObj.prijmy_ocekavane.wrapper.label, texts.sec8_multi);
		sharedLib.setOnValueChange(formObj.drivejsi_rizeni.wrapper.label, texts.sec9_multi);
		sharedLib.setOnValueChange(formObj.drivejsi_rizeni.wrapper.drivejsi_rizeni.text, texts.sec9_multi_sublabel);
		sharedLib.setOnCaptionChange(formObj.navrh_na_zmenu_splatky.wrapper.navrh_sekce.duvody_upadku_wrapper.duvody_upadku, texts.sec10_multi_duvody_upadku_caption);
		sharedLib.setOnValueChange(formObj.zahranicni_veritele.wrapper.zahr_veritele.text, texts.sec11_multi_sublabel);
	} else {
		sharedLib.setOnValueChange(formObj.dluznik.wrapper.label, texts.sec3);
		sharedLib.setOnValueChange(formObj.osoby_jednajici_za_dluznika.wrapper.label, texts.sec4);
		sharedLib.setOnValueChange(formObj.osoby_jednajici_za_dluznika.wrapper.osoby_switch.text, texts.sec4_sublabel);
		
		if (formObj.druh_navrhu.wrapper.spojeni_ano.rozhodnuti_o_upadku != null &amp;&amp; formObj.druh_navrhu.wrapper.spojeni_ano.rozhodnuti_o_upadku.rawValue == "2")
			sharedLib.setOnValueChange(formObj.popis_rozhodujicich_skutecnosti.wrapper.label, texts.sec5_2);
		else
			sharedLib.setOnValueChange(formObj.popis_rozhodujicich_skutecnosti.wrapper.label, texts.sec5);
			
		sharedLib.setOnValueChange(formObj.okolnosti_pro_vysi_plneni.wrapper.label, texts.sec6);
		sharedLib.setOnValueChange(formObj.prijmy.wrapper.label, texts.sec7);
		sharedLib.setOnValueChange(formObj.prijmy_ocekavane.wrapper.label, texts.sec8);
		//sharedLib.setOnCaptionChange(formObj.prijmy_ocekavane.wrapper.prijmy_ocekavane.dluznik.prijmyZ.prijmyDruh.druh, texts.sec8_prijmyZ);
		sharedLib.setOnValueChange(formObj.drivejsi_rizeni.wrapper.label, texts.sec9);
		sharedLib.setOnValueChange(formObj.drivejsi_rizeni.wrapper.drivejsi_rizeni.text, texts.sec9_sublabel);
		sharedLib.setOnCaptionChange(formObj.navrh_na_zmenu_splatky.wrapper.navrh_sekce.duvody_upadku_wrapper.duvody_upadku, texts.sec10_duvody_upadku_caption);
		sharedLib.setOnValueChange(formObj.zahranicni_veritele.wrapper.zahr_veritele.text, texts.sec11_sublabel);
	}	
}

function sec5_popis_caption(dalsi_skut, upadek, dluznik, spojeni, forma_upadku, formObjpopis) {
	if (formObjpopis == null)
		return;		
	if (spojeni != 1)
		return;
		
	if (upadek == "2") {		
		sharedLib.setOnCaptionChange(formObjpopis, texts.sec5_popis_caption_2);
	} else {
/*		if (! localLib.dluznikPodnikatel(dluznik)) {
			sharedLib.setOnCaptionChange(formObjpopis, texts.sec5_popis_caption_3);
			return;
		};
*/		if ( 
				dalsi_skut == 3 || 
				forma_upadku == 2
			) {
			sharedLib.setOnCaptionChange(formObjpopis, texts.sec5_popis_caption);
		}
		else {
			sharedLib.setOnCaptionChange(formObjpopis, texts.sec5_popis_caption_3);
		};
	}
};
</script>
         <script contentType="application/x-javascript" name="localLib">
function findAttachement (nazev) {
	ret = null;
	
	for (i = 0; i &lt; Formular.seznam_priloh.wrapper.listinne_prilohy_wrapper.listinne_prilohy._priloha.count; i++) {
		obj = xfa.resolveNode("Formular.seznam_priloh.wrapper.listinne_prilohy_wrapper.listinne_prilohy.priloha["+i+"]");
		if (obj.nazev.rawValue == nazev) {
			ret = obj;
			break;
		};
	};
	return ret;
}

function podpisConcatenate (objOsoba) {

	
	var podpis = "";
	if (objOsoba == null) 
		podpis = null
	else
		podpis = objOsoba.titul_pred.rawValue + objOsoba.jmeno.rawValue + objOsoba.prijmeni.rawValue + objOsoba.titul_za.rawValue;
	
	return podpis;
}

function dalsi_skutecnosti_init(forma_upadku, rozhodnuti_o_upadku, spojeni ) {
	if (forma_upadku == 1 &amp;&amp; rozhodnuti_o_upadku == 1 &amp;&amp; spojeni== 1)
		sharedLib.visibleIfHidden(Formular.popis_rozhodujicich_skutecnosti.wrapper.dalsi_skutecnosti.dalsi_skutecnosti)
	else  
		sharedLib.hideIfVisible(Formular.popis_rozhodujicich_skutecnosti.wrapper.dalsi_skutecnosti.dalsi_skutecnosti);
};

function dluznikPodnikatel(dluznik) {
	if (dluznik.wrapper._fyzicka_osoba.count &gt; 0) {
		if (dluznik.wrapper.resolveNode("fyzicka_osoba[0].udaje_osoba_wrapper.udaje_osoba.ico").rawValue != null) {
			return true;
		}
		
		if (dluznik.wrapper._fyzicka_osoba.count &gt; 1 &amp;&amp; dluznik.wrapper.resolveNode("fyzicka_osoba[1].udaje_osoba_wrapper.udaje_osoba.ico").rawValue != null) {
			return true;
		}
	} else if (dluznik.wrapper._pravnicka_osoba.count &gt; 0) {
		return true;
	}
	return false;
}
</script>
