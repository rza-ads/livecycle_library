<xfa:datasets xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/">
   <xfa:data xfa:dataNode="dataGroup"/>
   <dd:dataDescription xmlns:dd="http://ns.adobe.com/data-description/" dd:name="NNPO">
      <NNPO verze="">
         <prilohy>
            <obecna_priloha dd:minOccur="0" dd:maxOccur="-1" cislo="" nazev="" jmeno_souboru="" velikost_souboru="" dd:dataNode="dataGroup"/>
         </prilohy>
         <listinne_prilohy>
            <listinna_priloha dd:minOccur="0" dd:maxOccur="-1" cislo="" nazev="" dd:dataNode="dataGroup"/>
         </listinne_prilohy>
         <hlavicka>
            <spisznacka>
               <soud/>
               <senat/>
               <rejstrik/>
               <bc/>
               <rocnik/>
            </spisznacka>
            <druh_navrhu>
               <spojeni/>
               <spolecny_navrh/>
               <insolvence_proti_partnerovi switch="">
                  <spisznacka dd:minOccur="0">
                     <soud/>
                     <senat/>
                     <rejstrik/>
                     <bc/>
                     <rocnik/>
                  </spisznacka>
               </insolvence_proti_partnerovi>
               <druh_upadku/>
               <zp_oddluzeni/>
            </druh_navrhu>
         </hlavicka>
         <dluznik dd:model="choice" fo_po_switch="">
            <fyzicka_osoba dd:maxOccur="2">
               <osobni_udaje>
                  <osoba>
                     <prijmeni/>
                     <jmeno/>
                     <titul_pred dd:minOccur="0" dd:nullType="exclude"/>
                     <titul_za dd:minOccur="0" dd:nullType="exclude"/>
                     <ico dd:minOccur="0" dd:nullType="exclude"/>
                  </osoba>
                  <statni_prislusnost/>
                  <datum_narozeni/>
                  <rodne_cislo/>
                  <osobni_stav/>
               </osobni_udaje>
               <adresa>
                  <ulice/>
                  <cpop/>
                  <cori/>
                  <psc/>
                  <obec/>
                  <stat dd:minOccur="0" dd:nullType="exclude"/>
               </adresa>
               <koresp_adresa switch="">
                  <ulice/>
                  <cpop/>
                  <cori/>
                  <psc/>
                  <obec/>
                  <stat dd:minOccur="0" dd:nullType="exclude"/>
               </koresp_adresa>
               <kontakt>
                  <email/>
                  <dat_schr/>
                  <tel/>
               </kontakt>
            </fyzicka_osoba>
            <pravnicka_osoba>
               <firma>
                  <nazev/>
                  <ico/>
                  <jine_reg_c/>
               </firma>
               <pravni_rad_zalozeni/>
               <adresa>
                  <ulice/>
                  <cpop/>
                  <cori/>
                  <psc/>
                  <obec/>
                  <stat dd:minOccur="0" dd:nullType="exclude"/>
               </adresa>
               <koresp_adresa switch="">
                  <ulice/>
                  <cpop/>
                  <cori/>
                  <psc/>
                  <obec/>
                  <stat dd:minOccur="0" dd:nullType="exclude"/>
               </koresp_adresa>
               <kontakt>
                  <email/>
                  <dat_schr/>
                  <tel/>
               </kontakt>
            </pravnicka_osoba>
         </dluznik>
         <jednaji_za_dluznika dd:minOccur="0" switch="">
            <jedna_za_dluznika dd:minOccur="0" dd:maxOccur="3" fo_po_switch="">
               <osoba_je/>
               <dd:group dd:model="choice">
                  <fyzicka_osoba>
                     <osoba>
                        <prijmeni/>
                        <jmeno/>
                        <titul_pred dd:minOccur="0" dd:nullType="exclude"/>
                        <titul_za dd:minOccur="0" dd:nullType="exclude"/>
                        <ico dd:minOccur="0" dd:nullType="exclude"/>
                     </osoba>
                  </fyzicka_osoba>
                  <pravnicka_osoba>
                     <firma>
                        <nazev/>
                        <ico/>
                        <jine_reg_c/>
                     </firma>
                  </pravnicka_osoba>
               </dd:group>
            </jedna_za_dluznika>
         </jednaji_za_dluznika>
         <popis_rozhodujicich_skutecnosti>
            <forma_upadku dd:minOccur="0" dd:nullType="exclude"/>
            <zavazky>
               <zavazek dd:minOccur="0" dd:maxOccur="-1">
                  <poradi/>
                  <veritel/>
                  <duvod/>
                  <d_splatnosti/>
                  <vyse_zavazku/>
               </zavazek>
            </zavazky>
            <souhrn_zavazku dd:minOccur="0" dd:nullType="exclude"/>
            <hodnota_majetku dd:minOccur="0" dd:nullType="exclude"/>
            <dalsi_skutecnosti dd:minOccur="0" dd:nullType="exclude"/>
            <dalsi_skutecnosti_popis dd:minOccur="0" dd:nullType="exclude"/>
         </popis_rozhodujicich_skutecnosti>
         <okolnosti_pro_vysi_plneni>
            <vyz_povinnosti>
               <dluznik dd:maxOccur="2">
                  <pocet_vyzivovanych_osob/>
                  <vyzivne>
                     <vyse/>
                     <pocet_osob/>
                  </vyzivne>
                  <vyzivne_dluzne>
                     <vyse/>
                     <odhad/>
                  </vyzivne_dluzne>
               </dluznik>
            </vyz_povinnosti>
            <vyse_odmena/>
            <popis/>
         </okolnosti_pro_vysi_plneni>
         <prijmy_minule>
            <celkem/>
            <popis/>
         </prijmy_minule>
         <prijmy_ocekavane>
            <celkem/>
            <popis/>
            <dluznik_prijmy_z dd:maxOccur="2">
               <prijmy_z dd:maxOccur="-1">
                  <druh/>
                  <druh_detail dd:model="choice" dd:minOccur="0">
                     <jine dd:minOccur="0">
                        <platce dd:maxOccur="-1">
                           <poradi/>
                           <osoba_platce/>
                           <adresa_platce/>
                           <vyse/>
                           <ico/>
                        </platce>
                     </jine>
                     <osvc dd:minOccur="0">
                        <popis_podnikani/>
                        <vyse/>
                     </osvc>
                  </druh_detail>
               </prijmy_z>
            </dluznik_prijmy_z>
            <treti_osoba switch="">
               <platci>
                  <platce dd:minOccur="0" dd:maxOccur="-1">
                     <poradi/>
                     <osoba_platce/>
                     <adresa_platce/>
                     <vyse/>
                     <vyjadreni_dluznika/>
                  </platce>
               </platci>
            </treti_osoba>
            <prislib switch="">
               <vyjadreni/>
            </prislib>
         </prijmy_ocekavane>
         <schopnosti>
            <dluznik dd:maxOccur="2">
               <vzdelani/>
               <popis_vzdelani/>
               <dovednosti>
                  <dovednost dd:maxOccur="-1">
                     <druh/>
                     <popis/>
                  </dovednost>
               </dovednosti>
               <faktory>
                  <predchozi_zamestnani/>
                  <dojizdeni/>
                  <dalsi/>
               </faktory>
            </dluznik>
         </schopnosti>
         <drivejsi_rizeni switch="">
            <rizeni dd:minOccur="0" dd:maxOccur="-1">
               <spisznacka dd:minOccur="0">
                  <soud/>
                  <senat/>
                  <rejstrik/>
                  <bc/>
                  <rocnik/>
               </spisznacka>
               <zahranicni dd:minOccur="0" switch="">
                  <soud dd:minOccur="0" dd:nullType="exclude"/>
                  <spisznacka dd:minOccur="0" dd:nullType="exclude"/>
               </zahranicni>
            </rizeni>
            <osvob_pohl/>
            <oddluzeni_neschv/>
            <navrh_vzat_zpet/>
            <duvody/>
         </drivejsi_rizeni>
         <navrh_jina_splatka switch="">
            <vyse_nebo_urceni dd:minOccur="0" dd:nullType="exclude"/>
            <duvod_snizeni dd:minOccur="0" dd:nullType="exclude"/>
            <duvod_upadku dd:minOccur="0" dd:nullType="exclude"/>
         </navrh_jina_splatka>
         <zahranicni_veritele switch="">
            <z_veritel dd:minOccur="0" dd:maxOccur="-1">
               <poradi/>
               <veritel/>
               <duvod/>
               <adresa/>
            </z_veritel>
         </zahranicni_veritele>
         <podpisy>
            <podpis dd:maxOccur="2">
               <v_mesto/>
               <dne/>
               <osoba>
                  <prijmeni/>
                  <jmeno/>
                  <titul_pred dd:minOccur="0" dd:nullType="exclude"/>
                  <titul_za dd:minOccur="0" dd:nullType="exclude"/>
                  <ico dd:minOccur="0" dd:nullType="exclude"/>
               </osoba>
               <epodatelna dd:minOccur="0" switch="">
                  <guid dd:minOccur="0" dd:nullType="exclude"/>
                  <email dd:minOccur="0" dd:nullType="exclude"/>
               </epodatelna>
            </podpis>
         </podpisy>
      </NNPO>
   </dd:dataDescription>
</xfa:datasets></xdp:xdp>
