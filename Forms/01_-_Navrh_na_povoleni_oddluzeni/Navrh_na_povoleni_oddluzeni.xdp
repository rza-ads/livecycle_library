                              </corner>
                           </border>
                           <bind match="dataRef" ref="$.vyjadreni"/>
                           <assist>
                              <toolTip>Uveďte konkrétní důvody osvědčující, že plnění závazného příslibu neohrozí uspokojování základních potřeb dlužníka nebo osob na něj odkázaných výživou. Odůvodněte tedy, že je dlužník schopen při výpadku řádných srážek z příjmů platit ze své nezabavitelné částky minimální splátku, a současně mu zůstane dostatek disponibilních finančních prostředků na úhradu základních životních potřeb svých, svého manžela a dětí (strava, bydlení aj.).</toolTip>
                              <speak priority="toolTip"/>
                           </assist>
