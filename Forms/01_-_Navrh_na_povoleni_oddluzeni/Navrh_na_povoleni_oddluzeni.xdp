                     <event activity="initialize" name="event__initialize">
                        <script contentType="application/x-javascript">
if (this.rawValue == "1") {
	sharedLib.visibleIfHidden(popis_rozhodujicich_skutecnosti.wrapper.forma_upadku);
	
	if (localLib.dluznikPodnikatel(dluznik)) {
		sharedLib.openIfReadOnly(popis_rozhodujicich_skutecnosti.wrapper.forma_upadku.forma_upadku);	
	} else {
		//sharedLib.setOnValueChange(popis_rozhodujicich_skutecnosti.wrapper.forma_upadku.forma_upadku, "1");
		sharedLib.readOnlyIfOpen(popis_rozhodujicich_skutecnosti.wrapper.forma_upadku.forma_upadku);	
	}
		
	popis_rozhodujicich_skutecnosti.wrapper.forma_upadku.forma_upadku.execEvent("initialize");
} else {
	sharedLib.hideIfVisible(popis_rozhodujicich_skutecnosti.wrapper.forma_upadku);
	sharedLib.hideIfVisible(popis_rozhodujicich_skutecnosti.wrapper.celkem);
	
	sharedLib.visibleIfHidden(popis_rozhodujicich_skutecnosti.wrapper.dalsi_skutecnosti.popis);
}

popis_rozhodujicich_skutecnosti.wrapper.dalsi_skutecnosti.dalsi_skutecnosti.execInitialize();
labels.setFromUpadek(this.rawValue, popis_rozhodujicich_skutecnosti.wrapper.dalsi_skutecnosti.dalsi_skutecnosti.rawValue, Formular);
</script>
