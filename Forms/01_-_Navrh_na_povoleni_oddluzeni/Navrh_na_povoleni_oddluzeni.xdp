	z_veritele_table.presence = "hidden";
//	this.parent.parent._navrh_sekce.setInstances(0);
	
</script>
                     </event>
                     <event activity="change" name="event__change">
                        <script contentType="application/x-javascript">
// ano
if (this.rawValue == '1')
	//this.parent.parent._navrh_sekce.addInstance(0);
	z_veritele_table.presence = "visible";

// ne
if (this.rawValue == '0' || this.rawValue == null) {
	z_veritele_table.presence = "hidden";
	sharedLib.EraseAllChildFields(z_veritele_table);
	z_veritele_table.z_veritele._z_veritel.setInstances(1);
//	z_veritele_table.z_veritele.z_veritel.poradi.rawValue = 1;
}

</script>
