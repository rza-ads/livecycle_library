                              <event activity="click" name="event__click">
                                 <script contentType="application/x-javascript">
if (_zavazek.count &lt;= 2) {
	xfa.host.messageBox("Tabulka musí mít minimálně dva řádky. Řádek nelze odebrat.", "Řádek nelze odebrat", 3);
} else {
	_zavazek.removeInstance(this.parent.parent.index);
	xfa.form.recalculate(1);
}
</script>
                              </event>
                              <assist>
