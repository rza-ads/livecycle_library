                           <event activity="click" name="event__click">
                              <script contentType="application/x-javascript">
obj = _zadatel_wrapper.addInstance(1);
xfa.host.setFocus(obj.zadatel.druh_osoby.druh.fyzicka);


//podpis.wrapper._podpisy2.addInstance(1);
</script>
                           </event>
                        </field>
                        <field relevant="-print" h="5mm" name="btnRemove" w="5mm">
                           <border hand="right">
                              <corner thickness="0.2mm">
                                 <color value="130,130,130"/>
                              </corner>
                              <edge thickness="0.2mm">
                                 <color value="130,130,130"/>
                              </edge>
                              <fill/>
                           </border>
                           <caption>
                              <font typeface="Myriad Pro" size="12pt" weight="bold">
                                 <fill>
                                    <color value="251,85,91"/>
                                 </fill>
                              </font>
                              <para hAlign="center" vAlign="middle"/>
                              <value>
                                 <text>−</text>
                              </value>
                           </caption>
                           <font typeface="Myriad Pro"/>
                           <ui>
                              <button highlight="none"/>
                           </ui>
                           <bind match="none"/>
                           <event activity="click" name="event__click">
                              <script contentType="application/x-javascript">
if (_zadatel_wrapper.count &gt; 1) {
	if (zadatel_wrapper.index == 0) {
		xfa.host.messageBox("Nelze smazat prvního žadatele.");
	}
	else {
	//	podpis.wrapper._podpisy2.removeInstance(zadatel_wrapper.index - 1);
		_zadatel_wrapper.removeInstance(zadatel_wrapper.index);
	}
}
else {
	druh_osoby.druh.rawValue = null;
	druh_osoby.druh.execInitialize();
	_fyzicka_osoba.setInstances(0);
	_pravnicka_osoba.setInstances(0);
}

xfa.form.recalculate(1);
</script>
                           </event>
                        </field>
                        <?templateDesigner expand 0?></subform>
