         <script contentType="application/x-javascript" name="localLib">


function setTooltip(oObj, toolTip) {
	if ( oObj.assist.toolTip != toolTip) {
		oObj.assist.toolTip = toolTip
	};
}


function genID() {
	var ID = "ISIR_" + String(new Date().getTime());
	return ID;
};

function podpisConcatenate (objOsoba) {

	
	var podpis = "";
	if (objOsoba == null) 
		podpis = null
	else
		podpis = objOsoba.titul_pred.rawValue + objOsoba.jmeno.rawValue + objOsoba.prijmeni.rawValue + objOsoba.titul_za.rawValue;
	
	return podpis;
}
</script>
         <script contentType="application/x-javascript" name="preSign_local">
var jedno_z_nich = "";

var povinne = [
   {
   		sekce:
        {
          label:"Formular.zadatel.wrapper.label",
          label_txt:"",
          repeatfor:
            [{
