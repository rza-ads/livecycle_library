                        <subform w="190mm" layout="lr-tb" name="adresa_fo_wrapper">
                           <bind match="none"/>
                           <border>
                              <corner thickness="0.2mm">
                                 <color value="130,130,130"/>
                              </corner>
                              <edge thickness="0.2mm">
                                 <color value="130,130,130"/>
                              </edge>
                           </border>
                           <draw h="10mm" name="label_fo" w="25mm">
                              <assist>
                                 <speak priority="toolTip"/>
                                 <toolTip>Vyplňte svou adresu místa trvalého pobytu nebo sídlo v den podání návrhu na povolení oddlužení na území České republiky nebo v zahraničí.</toolTip>
                              </assist>
                              <font typeface="MyriadPro-Regular" baselineShift="0pt" size="9pt">
                                 <fill>
                                    <color value="51,51,51"/>
                                 </fill>
                              </font>
                              <margin bottomInset="0mm" leftInset="2mm" rightInset="0mm" topInset="1mm"/>
                              <para marginLeft="0pt" marginRight="0pt" spaceAbove="0pt" spaceBelow="0pt" textIndent="0pt"/>
                              <ui>
                                 <textEdit>
                                    <margin/>
                                 </textEdit>
                              </ui>
                              <value>
                                 <text>Bydliště/sídlo</text>
                              </value>
                           </draw>
                           <subform usehref="..\..\Fragments\form18_adresa.xdp#som($template.adresa.adresa)">
                              <margin bottomInset="0.5mm" topInset="0.5mm"/>
                              <bind match="dataRef" ref="$.adresa"/>
                              <?templateDesigner expand 1?>
                           </subform>
                           <?templateDesigner expand 0?></subform>
                        <subform w="190mm" layout="lr-tb" name="fo_wrapper">
                           <bind match="dataRef" ref="$.FO"/>
                           <border>
                              <corner thickness="0.2mm">
                                 <color value="130,130,130"/>
                              </corner>
                              <edge thickness="0.2mm">
                                 <color value="130,130,130"/>
                              </edge>
                           </border>
                           <subform w="190mm" minH="55.5mm" layout="lr-tb" name="wrapper">
                              <bind match="dataRef" ref="$.fyzicka_osoba[*]"/>
                              <field access="readOnly" h="7mm" name="poradi" w="108mm">
                                 <assist>
                                    <speak priority="toolTip"/>
                                 </assist>
                                 <calculate>
                                    <script contentType="application/x-javascript">
this.parent.index +1;
</script>
                                 </calculate>
                                 <caption reserve="89.96mm">
                                    <para marginLeft="2.835pt" marginRight="2.835pt" spaceAbove="1pt" vAlign="middle"/>
                                    <value>
                                       <text>Fyzické osoby, kterým má být zřízen dálkový přístup č.:</text>
                                    </value>
                                 </caption>
                                 <font typeface="Myriad Pro" weight="bold">
                                    <fill>
                                       <color value="51,51,51"/>
                                    </fill>
                                 </font>
                                 <margin bottomInset="0.5mm" leftInset="1mm" rightInset="1mm" topInset="0.5mm"/>
                                 <para marginLeft="2.835pt" marginRight="2.835pt" spaceAbove="1pt" vAlign="middle"/>
                                 <ui>
                                    <numericEdit hScrollPolicy="off">
                                       <border presence="hidden"/>
                                       <margin/>
                                    </numericEdit>
                                 </ui>
                                 <bind match="none"/>
                                 <validate>
                                    <message>
                                       <text name="scriptTest"/>
                                       <text name="formatTest"/>
                                    </message>
                                 </validate>
                                 <value>
                                    <integer/>
                                 </value>
                              </field>
                              <subform layout="lr-tb" name="buttons" w="82mm">
                                 <border>
                                    <corner presence="hidden" thickness="0.2mm">
                                       <color value="130,130,130"/>
                                    </corner>
                                    <corner presence="hidden" thickness="0.2mm"/>
                                    <corner presence="hidden" thickness="0.2mm"/>
                                    <corner presence="hidden" thickness="0.2mm"/>
                                    <edge presence="hidden" thickness="0.2mm">
                                       <color value="130,130,130"/>
                                    </edge>
                                 </border>
                                 <keep intact="contentArea"/>
                                 <margin bottomInset="1mm" leftInset="1mm" rightInset="1mm" topInset="1mm"/>
                                 <bind match="none"/>
                                 <field relevant="-print" h="5mm" name="btnAdd" w="5mm" hAlign="right">
                                    <border hand="right">
                                       <corner thickness="0.2mm">
                                          <color value="130,130,130"/>
                                       </corner>
                                       <edge thickness="0.2mm">
                                          <color value="130,130,130"/>
                                       </edge>
                                       <fill/>
                                    </border>
                                    <caption>
                                       <font typeface="Myriad Pro" size="12pt" weight="bold">
                                          <fill>
                                             <color value="77,114,149"/>
                                          </fill>
                                       </font>
                                       <para hAlign="center" vAlign="middle"/>
                                       <value>
                                          <text>+</text>
                                       </value>
                                    </caption>
                                    <font typeface="Myriad Pro"/>
                                    <ui>
                                       <button highlight="none"/>
                                    </ui>
                                    <bind match="none"/>
                                    <event activity="click" name="event__click">
                                       <script contentType="application/x-javascript">
obj = _wrapper.addInstance(1);
</script>
                                    </event>
                                 </field>
                                 <field relevant="-print" h="5mm" name="btnRemove" w="5mm" hAlign="right">
                                    <border hand="right">
                                       <corner thickness="0.2mm">
                                          <color value="130,130,130"/>
                                       </corner>
                                       <edge thickness="0.2mm">
                                          <color value="130,130,130"/>
                                       </edge>
                                       <fill/>
                                    </border>
                                    <caption>
                                       <font typeface="Myriad Pro" size="12pt" weight="bold">
                                          <fill>
                                             <color value="251,85,91"/>
                                          </fill>
                                       </font>
                                       <para hAlign="center" vAlign="middle"/>
                                       <value>
                                          <text>−</text>
                                       </value>
                                    </caption>
                                    <font typeface="Myriad Pro"/>
                                    <ui>
                                       <button highlight="none"/>
                                    </ui>
                                    <bind match="none"/>
                                    <event activity="click" name="event__click">
                                       <script contentType="application/x-javascript">
if (parent.parent.parent._wrapper.count &gt; 1) {
		parent.parent.parent._wrapper.removeInstance(parent.parent.parent._wrapper.index);
		}
	else {
		sharedLib.EraseAllChildFields	(fyzicka_osoba);
	}

xfa.form.recalculate(1);
</script>
                                    </event>
                                 </field>
