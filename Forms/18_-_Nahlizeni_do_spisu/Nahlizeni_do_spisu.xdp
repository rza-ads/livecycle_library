                  <subform usehref="..\..\Fragments\podpis.xdp#som($template.podpis.podpis)" name="podpis1">
                     <keep intact="contentArea"/>
                     <bind match="dataRef" ref="$.podpis"/>
                     <calculate>
                        <script contentType="application/x-javascript" runAt="client">

var t_pred_os = "";
var jm_os = "";
var pr_os = "";
var t_za_os = "";

//var oVeritel = xfa.resolveNode("zadatel.wrapper.zadatel_wrapper[" + (this.parent.index + 1) + "].zadatel");
var oVeritel = xfa.resolveNode("Formular.zadatel.wrapper.zadatel_wrapper[0].zadatel");


if (oVeritel != null  ) {
	if (oVeritel._fyzicka_osoba.count == 1) {
		t_pred_os = oVeritel.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.titul_pred.rawValue;
		jm_os = oVeritel.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.jmeno.rawValue;
		pr_os = oVeritel.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.prijmeni.rawValue;
		t_za_os = oVeritel.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.titul_za.rawValue;
		sharedLib.hideIfVisible(parent.zastupce);
		sharedLib.visibleIfHidden(parent.zadatel);
	
	}
	if (oVeritel._pravnicka_osoba.count == 1) {
		t_pred_os = oVeritel.pravnicka_osoba.zastupce.wrapper.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.titul_pred.rawValue;
		jm_os = oVeritel.pravnicka_osoba.zastupce.wrapper.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.jmeno.rawValue;
		pr_os = oVeritel.pravnicka_osoba.zastupce.wrapper.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.prijmeni.rawValue;
		t_za_os = oVeritel.pravnicka_osoba.zastupce.wrapper.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.titul_za.rawValue
		sharedLib.hideIfVisible(parent.zadatel);
		sharedLib.visibleIfHidden(parent.zastupce);
	}
	if (oVeritel._podnikajici_fyzicka_osoba.count == 1) {
		t_pred_os = oVeritel.podnikajici_fyzicka_osoba.zastupce.wrapper.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.titul_pred.rawValue;
		jm_os = oVeritel.podnikajici_fyzicka_osoba.zastupce.wrapper.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.jmeno.rawValue;
		pr_os = oVeritel.podnikajici_fyzicka_osoba.zastupce.wrapper.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.prijmeni.rawValue;
		t_za_os = oVeritel.podnikajici_fyzicka_osoba.zastupce.wrapper.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.titul_za.rawValue
		sharedLib.hideIfVisible(parent.zadatel);
		sharedLib.visibleIfHidden(parent.zastupce);
	}
	if (oVeritel._stat.count == 1) {
		t_pred_os = oVeritel.stat.zastupce.wrapper.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.titul_pred.rawValue;
		jm_os = oVeritel.stat.zastupce.wrapper.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.jmeno.rawValue;
		pr_os = oVeritel.stat.zastupce.wrapper.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.prijmeni.rawValue;
		t_za_os = oVeritel.stat.zastupce.wrapper.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba.titul_za.rawValue
		sharedLib.hideIfVisible(parent.zadatel);
		sharedLib.visibleIfHidden(parent.zastupce);
	}

	if(podpis_udaje.podepisujici.osoba.localOverrideLib.get() != "false"){
		sharedLib.setOnValueChange(podpis_udaje.podepisujici.osoba.titul_pred, t_pred_os);
		sharedLib.setOnValueChange(podpis_udaje.podepisujici.osoba.jmeno, jm_os);
		sharedLib.setOnValueChange(podpis_udaje.podepisujici.osoba.prijmeni, pr_os);
		sharedLib.setOnValueChange(podpis_udaje.podepisujici.osoba.titul_za, t_za_os);
	};
};
</script>
                     </calculate>
                     <event activity="initialize" ref="$" name="event__initialize">
                        <script contentType="application/x-javascript">

var podp_cont = "";


//var oVeritel = xfa.resolveNode("zadatel.wrapper.zadatel_wrapper[" + (this.parent.index + 1) + "].zadatel");
var oVeritel = xfa.resolveNode("Formular.zadatel.wrapper.zadatel_wrapper[0].zadatel");

if (oVeritel != null ) {
	if (oVeritel._fyzicka_osoba.count == 1) {
			podp_cont = localLib.podpisConcatenate(oVeritel.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba) ;
			sharedLib.hideIfVisible(parent.zastupce);
			sharedLib.visibleIfHidden(parent.zadatel);
	};
	if (oVeritel._pravnicka_osoba.count == 1) {
			podp_cont = localLib.podpisConcatenate(oVeritel.pravnicka_osoba.zastupce.wrapper.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba) ;
			sharedLib.hideIfVisible(parent.zadatel);
			sharedLib.visibleIfHidden(parent.zastupce);
	};
	if (oVeritel._podnikajici_fyzicka_osoba.count == 1) {
			podp_cont = localLib.podpisConcatenate(oVeritel.podnikajici_fyzicka_osoba.zastupce.wrapper.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba) ;
			sharedLib.hideIfVisible(parent.zadatel);
			sharedLib.visibleIfHidden(parent.zastupce);
	};
	if (oVeritel._stat.count == 1) {
			podp_cont = localLib.podpisConcatenate(oVeritel.stat.zastupce.wrapper.fyzicka_osoba.udaje_osoba_wrapper.udaje_osoba.osoba) ;
			sharedLib.hideIfVisible(parent.zadatel);
			sharedLib.visibleIfHidden(parent.zastupce);
	};

	if (localLib.podpisConcatenate(podpis_udaje.podepisujici.osoba) != podp_cont ) {
			podpis_udaje.podepisujici.osoba.localOverrideLib.set();
			sharedLib.hideIfVisible(parent.zadatel);
			sharedLib.visibleIfHidden(parent.zastupce);
	}
};
</script>
                     </event>
