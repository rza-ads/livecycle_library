                           <event activity="change" name="event__change">
                              <script contentType="application/x-javascript">// fyzicka
if (this.rawValue == '1') {
	//xfa.host.messageBox("fyzicka: " + this.rawValue);
	this.parent.parent._podnikajici_fyzicka_osoba.setInstances(0);
	this.parent.parent._pravnicka_osoba.setInstances(0);
	this.parent.parent._stat.setInstances(0);
	this.parent.parent._fyzicka_osoba.addInstance(1);
}

// pravnicka
if (this.rawValue == '2') {
	//xfa.host.messageBox("PO: " + this.rawValue);
	this.parent.parent._fyzicka_osoba.setInstances(0);
	this.parent.parent._podnikajici_fyzicka_osoba.setInstances(0);
	this.parent.parent._stat.setInstances(0);
	this.parent.parent._pravnicka_osoba.addInstance(1);
	pravnicka_osoba.udaje_firma_wrapper.udaje_firma.pravni_rad_zalozeni.rawValue = 'CZ';
}

// podnikajici FO
if (this.rawValue == '3') {
	//xfa.host.messageBox("Podn FO: " + this.rawValue);
	this.parent.parent._fyzicka_osoba.setInstances(0);
	this.parent.parent._pravnicka_osoba.setInstances(0);
	this.parent.parent._stat.setInstances(0);
	this.parent.parent._podnikajici_fyzicka_osoba.addInstance(1);}

// stat
if (this.rawValue == '4') {
	//xfa.host.messageBox("stat: " + this.rawValue);
	this.parent.parent._fyzicka_osoba.setInstances(0);
	this.parent.parent._podnikajici_fyzicka_osoba.setInstances(0);
	this.parent.parent._pravnicka_osoba.setInstances(0);
	this.parent.parent._stat.addInstance(1);
}
</script>
                           </event>
                           <?templateDesigner itemValuesSpecified 1?>
                           <?templateDesigner expand 1?></exclGroup>
                        <?templateDesigner expand 0?></subform>
